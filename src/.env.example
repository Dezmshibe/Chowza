# Public Supabase configuration used by the React client.
# These values are safe to expose to the browser when Supabase RLS is configured correctly.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Public canonical URL used by the server and payment return URLs.
PUBLIC_SITE_URL="https://chowza-jku1.onrender.com"

# Optional: comma-separated browser/native origins accepted by the CSRF layer.
# Keep secrets out of this file.
CSRF_ALLOWED_ORIGINS="https://chowza-jku1.onrender.com,capacitor://localhost,http://localhost,http://localhost:5173,http://localhost:4173,http://localhost:10000"
