
import { useEffect, useState } from 'react';
import type { Session } from '@supabase/supabase-js';
import { supabase } from '../lib/supabase';
import { BusinessAuth } from './BusinessAuth';

type BusinessProfile = {
  id: string;
  name: string;
  slug: string;
  description: string | null;
  public_phone: string | null;
  whatsapp_number: string | null;
  public_address: string | null;
  is_published: boolean;
};

type PortalState =
  | 'loading'
  | 'signed-out'
  | 'needs-business'
  | 'ready'
  | 'error';

export function BusinessPortalGate({ onBack }: { onBack: () => void }) {
  const [session, setSession] = useState<Session | null>(null);
  const [state, setState] = useState<PortalState>('loading');
  const [business, setBusiness] = useState<BusinessProfile | null>(null);
  const [error, setError] = useState('');
  const [name, setName] = useState('');
  const [slug, setSlug] = useState('');
  const [description, setDescription] = useState('');
  const [phone, setPhone] = useState('');
  const [whatsapp, setWhatsapp] = useState('');
  const [address, setAddress] = useState('');
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    let active = true;

    async function loadSession() {
      const { data, error } = await supabase.auth.getSession();

      if (!active) return;

      if (error) {
        setError(error.message);
        setState('error');
        return;
      }

      setSession(data.session);
      setState(data.session ? 'loading' : 'signed-out');
    }

    void loadSession();

    const {
      data: { subscription },
    } = supabase.auth.onAuthStateChange((_event, nextSession) => {
      if (!active) return;

      setSession(nextSession);
      setBusiness(null);
      setError('');
      setState(nextSession ? 'loading' : 'signed-out');
    });

    return () => {
      active = false;
      subscription.unsubscribe();
    };
  }, []);

  useEffect(() => {
    let active = true;

    async function loadBusiness() {
      if (!session?.user) {
        setBusiness(null);
        setState('signed-out');
        return;
      }

      setState('loading');
      setError('');

      const { data, error } = await supabase
        .from('businesses')
        .select(
          'id, name, slug, description, public_phone, whatsapp_number, public_address, is_published'
        )
        .eq('owner_id', session.user.id)
        .maybeSingle();

      if (!active) return;

      if (error) {
        setError(error.message);
        setState('error');
        return;
      }

      if (!data) {
        setBusiness(null);
        setState('needs-business');
        return;
      }

      setBusiness(data as BusinessProfile);
      setState('ready');
    }

    void loadBusiness();

    return () => {
      active = false;
    };
  }, [session]);

  async function createBusiness(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();

    if (!session?.user) {
      setError('Please log in before creating a business profile.');
      setState('error');
      return;
    }

    const cleanSlug = slug
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');

    if (!cleanSlug) {
      setError('Please enter a valid business web address.');
      return;
    }

    setSaving(true);
    setError('');

    const { data, error } = await supabase
      .from('businesses')
      .insert({
        owner_id: session.user.id,
        name: name.trim(),
        slug: cleanSlug,
        description: description.trim() || null,
        public_phone: phone.trim() || null,
        whatsapp_number: whatsapp.trim() || null,
        public_address: address.trim() || null,
        is_published: false,
      })
      .select(
        'id, name, slug, description, public_phone, whatsapp_number, public_address, is_published'
      )
      .single();

    setSaving(false);

    if (error) {
      setError(
        error.code === '23505'
          ? 'That business web address is already taken. Try another one.'
          : error.message
      );
      return;
    }

    setBusiness(data as BusinessProfile);
    setState('ready');
  }

  async function logOut() {
    const { error } = await supabase.auth.signOut();

    if (error) {
      setError(error.message);
      setState('error');
    }
  }

  if (state === 'signed-out') {
    return (
      <BusinessAuth
        onBack={onBack}
        onAuthenticated={async () => {
          const { data, error } = await supabase.auth.getSession();

          if (error) {
            setError(error.message);
            setState('error');
            return;
          }

          setSession(data.session);
          setState(data.session ? 'loading' : 'signed-out');
        }}
      />
    );
  }

  return (
    <main className="min-h-screen bg-[#F3EEE4] px-4 py-10">
      <section className="mx-auto max-w-2xl rounded-2xl border border-[#DED5C7] bg-white p-6 shadow-sm sm:p-8">
        <div className="flex items-start justify-between gap-4">
          <div>
            <p className="text-sm font-bold uppercase tracking-widest text-[#70452E]">
              Chowza for Business
            </p>
            <h1 className="mt-2 text-3xl font-extrabold text-[#1B1815]">
              {state === 'loading'
                ? 'Checking your account'
                : state === 'needs-business'
                  ? 'Set up your business'
                  : state === 'error'
                    ? 'Account issue'
                    : business?.name ?? 'Your business'}
            </h1>
          </div>

          {session && (
            <button
              type="button"
              onClick={logOut}
              className="rounded-lg border border-[#D9D0C3] px-3 py-2 text-sm font-semibold"
            >
              Log out
            </button>
          )}
        </div>

        {state === 'loading' && (
          <p className="mt-6 text-sm text-[#6B6258]">
            Please wait while we check your account…
          </p>
        )}

        {state === 'needs-business' && (
          <>
            <p className="mt-3 text-sm leading-6 text-[#6B6258]">
              Your account is signed in. Add your business details to create
              your private business profile. It will remain unpublished until
              you choose to publish it later.
            </p>

            <form onSubmit={createBusiness} className="mt-6 space-y-4">
              <div>
                <label htmlFor="business-name" className="mb-1 block text-sm font-semibold">
                  Business name
                </label>
                <input
                  id="business-name"
                  required
                  maxLength={100}
                  value={name}
                  onChange={(event) => setName(event.target.value)}
                  className="w-full rounded-xl border border-[#D9D0C3] px-4 py-3 text-sm"
                  placeholder="e.g. Makhulu's Kitchen"
                />
              </div>

              <div>
                <label htmlFor="business-slug" className="mb-1 block text-sm font-semibold">
                  Business web address
                </label>
                <input
                  id="business-slug"
                  required
                  maxLength={80}
                  value={slug}
                  onChange={(event) => setSlug(event.target.value)}
                  className="w-full rounded-xl border border-[#D9D0C3] px-4 py-3 text-sm"
                  placeholder="e.g. makhulus-kitchen"
                />
                <p className="mt-1 text-xs text-[#8A8177]">
                  Letters, numbers and hyphens are allowed. We'll tidy the format automatically.
                </p>
              </div>

              <div>
                <label htmlFor="business-description" className="mb-1 block text-sm font-semibold">
                  Description (optional)
                </label>
                <textarea
                  id="business-description"
                  value={description}
                  onChange={(event) => setDescription(event.target.value)}
                  rows={3}
                  maxLength={1000}
                  className="w-full rounded-xl border border-[#D9D0C3] px-4 py-3 text-sm"
                />
              </div>

              <div>
                <label htmlFor="business-phone" className="mb-1 block text-sm font-semibold">
                  Public phone number (optional)
                </label>
                <input
                  id="business-phone"
                  type="tel"
                  value={phone}
                  onChange={(event) => setPhone(event.target.value)}
                  className="w-full rounded-xl border border-[#D9D0C3] px-4 py-3 text-sm"
                />
              </div>

              <div>
                <label htmlFor="business-whatsapp" className="mb-1 block text-sm font-semibold">
                  WhatsApp number (optional)
                </label>
                <input
                  id="business-whatsapp"
                  type="tel"
                  value={whatsapp}
                  onChange={(event) => setWhatsapp(event.target.value)}
                  className="w-full rounded-xl border border-[#D9D0C3] px-4 py-3 text-sm"
                />
              </div>

              <div>
                <label htmlFor="business-address" className="mb-1 block text-sm font-semibold">
                  Public address (optional)
                </label>
                <input
                  id="business-address"
                  value={address}
                  onChange={(event) => setAddress(event.target.value)}
                  className="w-full rounded-xl border border-[#D9D0C3] px-4 py-3 text-sm"
                />
              </div>

              {error && (
                <p role="alert" className="rounded-lg bg-red-50 p-3 text-sm text-red-700">
                  {error}
                </p>
              )}

              <button
                type="submit"
                disabled={saving}
                className="w-full rounded-xl bg-[#2F160D] px-4 py-3 font-bold text-white disabled:opacity-60"
              >
                {saving ? 'Saving business…' : 'Create business profile'}
              </button>
            </form>
          </>
        )}

        {state === 'ready' && business && (
          <div className="mt-6 space-y-3">
            <p className="text-sm text-[#6B6258]">
              Your business profile is saved to your new Chowza V2 database.
            </p>

            <div className="rounded-xl border border-[#DED5C7] bg-[#FAF8F4] p-4">
              <p className="text-xs font-semibold uppercase tracking-wide text-[#8A8177]">
                Business web address
              </p>
              <p className="mt-1 font-bold text-[#1B1815]">{business.slug}</p>

              <p className="mt-4 text-xs font-semibold uppercase tracking-wide text-[#8A8177]">
                Publishing status
              </p>
              <p className="mt-1 font-bold text-[#1B1815]">
                {business.is_published ? 'Published' : 'Unpublished'}
              </p>
            </div>

            <p className="text-sm leading-6 text-[#6B6258]">
              This is the secure account and profile setup stage. Menu management,
              order management and publishing controls will be added separately.
            </p>
          </div>
        )}

        {state === 'error' && (
          <div className="mt-6">
            <p role="alert" className="rounded-lg bg-red-50 p-3 text-sm text-red-700">
              {error || 'We could not load your account. Please try again.'}
            </p>
            <button
              type="button"
              onClick={() => window.location.reload()}
              className="mt-4 rounded-xl bg-[#2F160D] px-4 py-3 font-bold text-white"
            >
              Try again
            </button>
          </div>
        )}
      </section>
    </main>
  );
}

