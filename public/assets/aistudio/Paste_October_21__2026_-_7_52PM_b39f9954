    payload = {
        "messaging_product": "whatsapp",
        "to": recipient,
        "type": "text",
        "text": {
            "preview_url": False,
            "body": text
        }
    }

    try:
        response = outbound_request(
            "POST",
            url,
            headers=headers,
            json=payload,
            timeout=15
        )

        if response.ok:
            safe_log("WHATSAPP MESSAGE SENT:", recipient)
            return True

        safe_log(
