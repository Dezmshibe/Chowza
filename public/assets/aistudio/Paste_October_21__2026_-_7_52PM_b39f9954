# ============================================================

@app.route(
    "/yoco/payment/success/<int:order_id>",
    methods=["GET"]
)
def yoco_payment_success(order_id):

    order = lock_row(
        Order.query.filter(Order.id == order_id)
    )

    if not order:
        return (
            "Order not found.",
            404
        )

    business = db.session.get(
        Business,
        order.business_id
    )

    if not business:
        return (
            "Business not found.",
            404
        )

    # --------------------------------------------------------
    # Only Yoco orders can use this route.
    # --------------------------------------------------------

    if order.payment_method != "Yoco":
        return (
            "Invalid payment method.",
            400
        )

    # --------------------------------------------------------
    # Prevent duplicate processing.
    # --------------------------------------------------------

    if order.payment_status == "Paid":
        return redirect(
            url_for(
                "order_confirmation",
                order_id=order.id
            )
        )

    # --------------------------------------------------------
    # Verify the payment directly with Yoco.
    #
    # Never trust the browser redirect itself.
    # --------------------------------------------------------

    try:

        yoco_result = verify_yoco_checkout(
            order,
            business
        )

        safe_log(
            "YOCO ACTUAL PAYMENT RESULT:",
            yoco_result
        )

    except Exception as e:

        safe_log(
            "YOCO PAYMENT VERIFICATION ERROR:",
            repr(e)
        )

        return (
            "We could not verify your payment yet. "
            "Please contact the business if you were charged.",
            502
        )

    # --------------------------------------------------------
    # Check Yoco's actual checkout status.
    # --------------------------------------------------------

    yoco_status = str(
        yoco_result.get(
            "status",
            ""
        )
    ).strip().lower()

    if yoco_status != "completed":

        return (
            "Payment has not been confirmed yet.",
            400
        )

    if not yoco_payment_matches_order(order, yoco_result):
        safe_log("YOCO PAYMENT REJECTED: amount mismatch", order.id)
        return (
            "Payment details could not be matched to this order.",
            400
        )

    # --------------------------------------------------------
    # Payment is confirmed.
    #
    # The Yoco webhook remains responsible for the
    # business WhatsApp notification.
    # --------------------------------------------------------

    try:
        set_payment_status_safely(order, "Paid")
    except ValueError:
        if order.payment_status == "Paid":
            grant_order_session_access(order.id)
            return redirect(url_for("order_confirmation", order_id=order.id))
        return ("Payment state could not be updated safely.", 409)

    try:

        db.session.commit()

    except Exception as e:

        db.session.rollback()

        safe_log(
            "YOCO PAYMENT SAVE ERROR:",
            repr(e)
        )

        return (
            "Payment was verified but "
            "could not be saved.",
            500
        )

    # --------------------------------------------------------
    # Do NOT notify the business here.
    #
    # The Yoco webhook handles the business notification
    # after receiving payment.succeeded.
    # This prevents the browser success redirect and webhook
    # from independently sending duplicate notifications.
    # --------------------------------------------------------

    grant_order_session_access(order.id)

    return redirect(
        url_for(
            "order_confirmation",
            order_id=order.id
        )
    )


