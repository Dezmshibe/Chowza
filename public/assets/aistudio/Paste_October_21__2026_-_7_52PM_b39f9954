SECURITY_HARDENING_VERSION = "25"
MAX_DB_ORDER_TOTAL = Decimal("10000.00")
MAX_PROVIDER_ID_LENGTH = 255


def _validate_finite_order_total(value):
    try:
        amount = Decimal(str(value))
    except (InvalidOperation, TypeError, ValueError):
        raise ValueError("Order total is invalid.")
    if not amount.is_finite() or amount < Decimal("0") or amount > MAX_DB_ORDER_TOTAL:
        raise ValueError("Order total is outside the permitted range.")
    return amount


def _validate_provider_identifier(value, field_name):
    if value is None:
        return
    value = str(value).strip()
    if len(value) > MAX_PROVIDER_ID_LENGTH:
        raise ValueError(f"{field_name} is too long.")


@event.listens_for(Session, "before_flush")
def chowza_final_transaction_guard(session, flush_context, instances):
    """Final database-side application guard for critical financial/order state.

    This does not replace route authorization or provider verification. It is a
    last line of defence against accidental or concurrent application code
    writing impossible monetary/payment states.
    """
    for obj in session.new.union(session.dirty):
        if isinstance(obj, Order):
            _validate_finite_order_total(obj.total)
            status = str(obj.status or "Pending").strip()
            payment_status = str(obj.payment_status or "Awaiting Payment").strip()
            if status not in ORDER_STATUS_TRANSITIONS and status not in {
                "Pending", "Accepted", "Preparing", "Ready", "Completed", "Cancelled"
            }:
                raise ValueError("Invalid order status.")
            if payment_status not in PAYMENT_STATUS_TRANSITIONS:
                raise ValueError("Invalid payment status.")
            if obj.client_request_id is not None and len(str(obj.client_request_id)) > 80:
                raise ValueError("Checkout idempotency key is too long.")
            if obj.payment_reference is not None:
                _validate_provider_identifier(obj.payment_reference, "Payment reference")

        elif isinstance(obj, SubscriptionPayment):
            try:
                amount = Decimal(str(obj.amount or 0))
            except (InvalidOperation, TypeError, ValueError):
                raise ValueError("Subscription payment amount is invalid.")
            if not amount.is_finite() or amount < Decimal("0") or amount > Decimal("1000000"):
                raise ValueError("Subscription payment amount is outside the permitted range.")
            _validate_provider_identifier(obj.provider_payment_id, "Provider payment ID")


