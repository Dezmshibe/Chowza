def subscription_is_active(business):
    """
    Return True while a business has an active trial,
    active paid subscription, or approved grace period.
    """
    if not business:
        return False

    status = (
        business.subscription_status
        or "trialing"
    ).strip().lower()

    now = utc_now()

    # --------------------------------------------------------
    # FREE TRIAL
    # --------------------------------------------------------
    if status == "trialing":

        if not business.trial_ends_at:
            return True

        trial_end = business.trial_ends_at

        if trial_end.tzinfo is None:
            trial_end = trial_end.replace(
                tzinfo=timezone.utc
            )

        return now < trial_end

    # --------------------------------------------------------
    # PAID SUBSCRIPTION
    # --------------------------------------------------------
    if status == "active":

        if not business.subscription_current_period_end:
            return True

        period_end = (
            business.subscription_current_period_end
        )

        if period_end.tzinfo is None:
            period_end = period_end.replace(
                tzinfo=timezone.utc
            )

        return now < period_end

    # --------------------------------------------------------
    # 3-DAY PAYMENT GRACE PERIOD
    # --------------------------------------------------------
    if status == "past_due":

        period_end = business.subscription_current_period_end

        if not period_end:
            return False

        if period_end.tzinfo is None:
            period_end = period_end.replace(
                tzinfo=timezone.utc
            )

        grace_end = (
            period_end
            + timedelta(
                days=SUBSCRIPTION_GRACE_DAYS
            )
        )

        return now <= grace_end

    return False


def sync_subscription_state(
    business,
    *,
    commit=True
):
    """
    Synchronise subscription expiry and keep businesses active
    during the approved 3-day payment grace period.
    """
    if not business:
        return False

    # Subscription expiry can be evaluated concurrently by multiple requests.
    # PostgreSQL locks the business row so only one request can transition the
    # subscription state at a time. SQLite serialises writes at the database level.
    if db.engine.url.get_backend_name() != "sqlite" and getattr(business, "id", None):
        locked_business = lock_business_for_update(business.id)
        if locked_business is None:
            return False
        business = locked_business

    now = utc_now()
    changed = False

    status = (
        business.subscription_status
        or "trialing"
    ).strip().lower()

    # --------------------------------------------------------
    # TRIAL EXPIRY
    # --------------------------------------------------------
    if (
        status == "trialing"
        and business.trial_ends_at
    ):
        trial_end = business.trial_ends_at

        if trial_end.tzinfo is None:
            trial_end = trial_end.replace(
                tzinfo=timezone.utc
            )

        if now >= trial_end:
            business.subscription_status = "past_due"
            business.subscription_payment_status = (
                "payment_required"
            )
            business.active = True
            changed = True

    # --------------------------------------------------------
    # PAID PERIOD EXPIRY
    # --------------------------------------------------------
    elif (
        status == "active"
        and business.subscription_current_period_end
    ):
        period_end = (
            business.subscription_current_period_end
        )

        if period_end.tzinfo is None:
            period_end = period_end.replace(
                tzinfo=timezone.utc
            )

        if now >= period_end:
            business.subscription_status = "past_due"
            business.subscription_payment_status = (
                "payment_required"
            )
            business.active = True
            business.subscription_next_payment_at = None
            changed = True

    # --------------------------------------------------------
    # PAYMENT GRACE PERIOD
    # --------------------------------------------------------
    elif status == "past_due":

        if not business.subscription_current_period_end:
            if business.active:
                business.active = False
                changed = True
        else:
            period_end = (
                business.subscription_current_period_end
            )

            if period_end.tzinfo is None:
                period_end = period_end.replace(
                    tzinfo=timezone.utc
                )

            grace_end = (
                period_end
                + timedelta(
                    days=SUBSCRIPTION_GRACE_DAYS
                )
            )

            # Still inside grace period.
            if now <= grace_end:

                if not business.active:
                    business.active = True
                    changed = True

                if business.subscription_payment_status != "payment_required":
                    business.subscription_payment_status = (
                        "payment_required"
                    )
                    changed = True

            else:

                # Grace period has ended.
                business.subscription_status = "expired"
                business.subscription_payment_status = (
                    "payment_required"
                )
                business.active = False
                changed = True

    # --------------------------------------------------------
    # CANCELLED / EXPIRED
    # --------------------------------------------------------
    elif status in {"expired", "cancelled"}:
        if business.active:
            business.active = False
            changed = True

    if changed and commit:
        db.session.commit()

    return changed


def get_subscription_state(business):
    """Return a small, template/API-friendly subscription state."""
    if not business:
        return {
            "plan": DEFAULT_PLAN,
            "status": "cancelled",
            "active": False,
            "trialing": False,
            "trial_ends_at": None,
            "days_remaining": 0,
        }

    status = (business.subscription_status or "trialing").strip().lower()
    active = subscription_is_active(business)
    trialing = status == "trialing" and active and bool(business.trial_ends_at)
    days_remaining = 0

    if trialing:
        trial_end = business.trial_ends_at
        if trial_end.tzinfo is None:
            trial_end = trial_end.replace(tzinfo=timezone.utc)
        seconds = max(0, (trial_end - utc_now()).total_seconds())
        days_remaining = int((seconds + 86399) // 86400)

    return {
        "plan": (business.plan or DEFAULT_PLAN).strip().lower(),
        "status": status,
        "active": active,
        "trialing": trialing,
        "trial_ends_at": business.trial_ends_at,
        "days_remaining": days_remaining,
    }


def requires_feature(feature):
    """Gate a business-owner route by subscription status and plan feature."""
    def decorator(view):
        @wraps(view)
        def wrapped(*args, **kwargs):
            if not current_user.is_authenticated:
                return redirect(url_for("business_login"))

            business_id = getattr(current_user, "business_id", None)
            business = db.session.get(Business, business_id) if business_id else None

            if not business:
                flash("This account is not connected to a business.")
                return redirect(url_for("dashboard"))

            if not subscription_is_active(business):
                flash("Your Chowza trial or subscription has ended. Choose a plan to continue.")
                return redirect(url_for("pricing"))

            if not plan_has_feature(business.plan, feature):
                flash("This feature is not included in your current plan. Upgrade to unlock it.")
                return redirect(url_for("pricing"))

            return view(*args, **kwargs)

        return wrapped

    return decorator


