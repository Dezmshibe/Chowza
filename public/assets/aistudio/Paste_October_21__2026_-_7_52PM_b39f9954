                normalized_phone = normalize_phone(phone)

                if len(normalized_phone) < 10:
                    error = "Please enter a valid phone number."
                else:
                    candidates = (
                        Order.query
                        .filter(Order.order_number == cleaned_order_number)
                        .order_by(Order.created_at.desc(), Order.id.desc())
                        .limit(5)
                        .all()
                    )
                    order = next(
                        (candidate for candidate in candidates
                         if normalize_phone(candidate.customer_phone) == normalized_phone),
                        None
                    )

                    if not order:
                        error = (
                            "Order not found. Please check your order "
                            "number and phone number."
                        )
                    else:
                        stored_phone = normalize_phone(order.customer_phone)

                        if stored_phone != normalized_phone:
                            order = None
                            error = (
                                "Order not found. Please check your order "
                                "number and phone number."
                            )
                        else:
                            items = get_order_items(order)

            except ValueError:
                error = "Please enter a valid order number."

    response = make_response(render_template(
        "track_order.html",
        order=order,
        items=items,
        error=error,
        order_id=order_id,
        phone=phone,
        cancellable_statuses=CUSTOMER_CANCELLABLE_STATUSES
    ))
    return mark_sensitive_response(response)

