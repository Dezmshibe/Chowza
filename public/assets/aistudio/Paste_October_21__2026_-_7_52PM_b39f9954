WHATSAPP_VERIFY_TOKEN = os.environ.get(
    "WHATSAPP_VERIFY_TOKEN", ""
).strip()

if DATABASE_URL and not WHATSAPP_VERIFY_TOKEN:
    raise RuntimeError(
        "WHATSAPP_VERIFY_TOKEN must be configured in production."
    )


def verify_whatsapp_webhook_signature(raw_body, signature, app_secret):
    """
    Verify Meta WhatsApp Cloud API webhook POST requests.

    Meta sends:
        X-Hub-Signature-256: sha256=<hex digest>

    The digest is HMAC-SHA256 of the raw request body using the
    Meta App Secret.
    """
    if not raw_body or not signature or not app_secret:
        return False

    supplied = signature.strip()

    if not supplied.startswith("sha256="):
        return False

    supplied_digest = supplied[7:].strip().lower()

    if not re.fullmatch(r"[0-9a-f]{64}", supplied_digest):
        return False

    expected_digest = hmac.new(
        app_secret.encode("utf-8"),
        raw_body,
        hashlib.sha256
    ).hexdigest()

    return hmac.compare_digest(
        supplied_digest,
        expected_digest
    )

