@app.errorhandler(413)
def request_entity_too_large(error):
    if request.path.startswith("/place-order") or request.path.startswith("/analytics/event") or request.path.startswith("/api/"):
        return jsonify({
            "success": False,
            "message": "Request is too large."
        }), 413
    return "Request is too large.", 413


def _is_json_request_path():
    return (
        request.path.startswith("/api/")
        or request.path.startswith("/analytics/")
        or request.path.startswith("/webhook/")
        or request.path.startswith("/whatsapp/")
        or request.path.startswith("/yoco/")
        or request.path.startswith("/payfast/")
    )


@app.errorhandler(400)
def bad_request(error):
    safe_log("HTTP 400", request.method, request.path, level="warning")
    if _is_json_request_path():
        return jsonify({"success": False, "message": "Bad request."}), 400
    return "Bad request.", 400


@app.errorhandler(403)
def forbidden(error):
    safe_log("HTTP 403", request.method, request.path, level="warning")
    if _is_json_request_path():
        return jsonify({"success": False, "message": "Access denied."}), 403
    return "Access denied.", 403


@app.errorhandler(404)
def page_not_found(error):
    safe_log("HTTP 404", request.method, request.path, level="info")
    return render_template("404.html"), 404


@app.errorhandler(405)
def method_not_allowed(error):
    safe_log("HTTP 405", request.method, request.path, level="warning")
    if _is_json_request_path():
        return jsonify({"success": False, "message": "Method not allowed."}), 405
    return "Method not allowed.", 405


@app.errorhandler(429)
def too_many_requests(error):
    safe_log("HTTP 429 rate limit", request.method, request.path, level="warning")
    if _is_json_request_path():
        return jsonify({"success": False, "message": "Too many requests. Please try again later."}), 429
    return "Too many requests. Please try again later.", 429


@app.errorhandler(500)
def internal_server_error(error):
    db.session.rollback()
    safe_log("HTTP 500 internal server error", type(error).__name__, level="error")
    if _is_json_request_path():
        return jsonify({
            "success": False,
            "message": "Internal server error. Please try again later."
        }), 500
    return "Internal server error. Please try again later.", 500


