@limiter.limit("10 per minute")
@limiter.limit("5 per 15 minutes", methods=["POST"])
@app.route("/business-login", methods=["GET", "POST"])
def business_login():

    if current_user.is_authenticated:
        return redirect(url_for("dashboard"))

    if request.method == "POST":
        username = request.form.get("username", "").strip()
        password = request.form.get("password", "")

        # Keep authentication inputs bounded to prevent oversized form
        # submissions from consuming unnecessary CPU/memory.
        if len(username) > MAX_LOGIN_USERNAME_LENGTH or len(password) > MAX_LOGIN_PASSWORD_LENGTH:
            flash("Invalid username or password.")
            return render_template("business_login.html"), 400

        locked, remaining_minutes = is_login_locked(username)

        if locked:
            # Do not reveal whether the username exists.
            flash(
                "Too many failed login attempts. "
                f"Please try again in approximately {remaining_minutes} minute(s)."
            )
            return render_template("business_login.html"), 429

        user = User.query.filter(
            db.func.lower(User.username) == username.casefold()
        ).first()

        # A normal business account must remain attached to exactly one
        # business. Orphaned non-admin accounts are denied instead of
        # being allowed into a partially initialised session.
        account_business = (
            db.session.get(Business, user.business_id)
            if user and getattr(user, "business_id", None)
            else None
        )

        valid_credentials = bool(
            user
            and user.password_hash
            and check_password_hash(user.password_hash, password)
        )

        if valid_credentials:
            if not getattr(user, "is_admin", False) and not account_business:
                clear_login_attempts(username)
                flash("This account is not currently linked to a business.")
                return render_template("business_login.html"), 403

            if account_business and (
                getattr(account_business, "suspended", False)
                or not getattr(account_business, "active", True)
            ):
                clear_login_attempts(username)
                flash("This business account is currently unavailable.")
                return render_template("business_login.html"), 403

            clear_login_attempts(username)

            # Rotate the Flask session before establishing the authenticated
            # session to reduce session-fixation risk. Analytics identifiers
            # are stored in separate cookies and are unaffected.
            session.clear()
            login_user(user, remember=False, fresh=True)
            session.permanent = True

            next_url = request.args.get("next", "")

            if (
                next_url
                and next_url.startswith("/")
                and not next_url.startswith("//")
            ):
                return redirect(next_url)

            return redirect(url_for("dashboard"))

        account_locked = record_failed_login(username)

        if account_locked:
            flash(
                "Too many failed login attempts. "
                f"This login has been temporarily locked for {LOGIN_LOCK_MINUTES} minutes."
            )
        else:
            flash("Invalid username or password.")

    return render_template("business_login.html")


