def grant_order_session_access(order_id):
    """Grant the current browser access to its own order confirmation."""
    try:
        order_id = int(order_id)
    except (TypeError, ValueError):
        return

    allowed = session.get("customer_order_access", [])
    if not isinstance(allowed, list):
        allowed = []

    allowed = [str(x) for x in allowed if str(x).isdigit()]
    if str(order_id) not in allowed:
        allowed.append(str(order_id))

    # Keep the session small and limit the number of historical IDs.
    session["customer_order_access"] = allowed[-10:]
    session.modified = True


def mark_sensitive_response(response):
    """Prevent browsers/proxies from caching customer order data."""
    response.headers["Cache-Control"] = "no-store, no-cache, must-revalidate, max-age=0"
    response.headers["Pragma"] = "no-cache"
    response.headers["Expires"] = "0"
    return response


def mask_phone_for_log(phone):
    """Return a non-sensitive representation suitable for server logs."""
    digits = re.sub(r"\D", "", str(phone or ""))
    if len(digits) <= 4:
        return "***"
    return "*" * max(0, len(digits) - 4) + digits[-4:]


def has_order_session_access(order_id):
    try:
        order_id = int(order_id)
    except (TypeError, ValueError):
        return False

    allowed = session.get("customer_order_access", [])
    if not isinstance(allowed, list):
        return False

    return str(order_id) in {str(x) for x in allowed}


