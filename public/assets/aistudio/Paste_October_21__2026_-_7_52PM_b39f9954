def run_production_security_checks():
    """Fail closed on dangerous production configuration mistakes."""
    if not DATABASE_URL:
        return

    if DEBUG or app.config.get("PROPAGATE_EXCEPTIONS"):
        raise RuntimeError("Production security check failed: debug/exception propagation is enabled.")

    required = {
        "WHATSAPP_FOOD_SECRET_KEY": os.environ.get("WHATSAPP_FOOD_SECRET_KEY", "").strip(),
        "CHOWZA_ENCRYPTION_KEY": os.environ.get("CHOWZA_ENCRYPTION_KEY", "").strip(),
        "REDIS_URL": os.environ.get("REDIS_URL", "").strip(),
        "PUBLIC_BASE_URL": PUBLIC_BASE_URL,
    }
    missing = [key for key, value in required.items() if not value]
    if missing:
        raise RuntimeError("Production security check failed: missing required environment variables.")

    optional_provider_requirements = []
    # Active integrations must not silently run without their authenticity secrets.
    if WHATSAPP_ACCESS_TOKEN or WHATSAPP_PHONE_NUMBER_ID:
        optional_provider_requirements.append(("WHATSAPP_APP_SECRET", WHATSAPP_APP_SECRET))
    if PAYFAST_MERCHANT_ID or PAYFAST_MERCHANT_KEY:
        optional_provider_requirements.extend([
            ("PAYFAST_MERCHANT_ID", PAYFAST_MERCHANT_ID),
            ("PAYFAST_MERCHANT_KEY", PAYFAST_MERCHANT_KEY),
        ])
    for name, value in optional_provider_requirements:
        if not value:
            raise RuntimeError("Production security check failed: an enabled provider integration is missing required credentials.")

    if not _validate_public_base_url(PUBLIC_BASE_URL):
        raise RuntimeError("Production security check failed: PUBLIC_BASE_URL must be HTTPS.")


