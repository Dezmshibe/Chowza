# ============================================================

def generate_daily_order_number(business_id):
    """Generate the next order number for a business.

    The number resets at midnight in South Africa and is independent
    for every business. The internal Order.id is never changed.
    """

    now_sa = datetime.now(timezone.utc).astimezone(SOUTH_AFRICA_TZ)
    today = now_sa.date()

    # PostgreSQL row lock prevents two simultaneous orders for the
    # same business from receiving the same customer-facing number.
    if db.engine.url.get_backend_name() != "sqlite":
        db.session.execute(
            db.select(Business.id)
            .where(Business.id == business_id)
            .with_for_update()
        )

    last_order = (
        Order.query
        .filter(
            Order.business_id == business_id,
            Order.order_day == today,
            Order.order_number.isnot(None)
        )
        .order_by(Order.id.desc())
        .first()
    )

    next_number = 1

    if last_order and last_order.order_number:
        try:
            next_number = int(str(last_order.order_number).strip()) + 1
        except (TypeError, ValueError):
            next_number = 1

    return f"{next_number:03d}", today


