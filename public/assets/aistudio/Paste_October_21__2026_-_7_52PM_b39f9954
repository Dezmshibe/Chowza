    businesses = (
        Business.query
        .order_by(Business.created_at.desc(), Business.id.desc())
        .limit(ADMIN_LIST_LIMIT)
        .all()
    )

    # Keep subscription state current before displaying the dashboard.
    for business in businesses:
        try:
            sync_subscription_state(business, commit=False)
        except Exception as exc:
            safe_log("ADMIN SUBSCRIPTION SYNC ERROR:", repr(exc))

    total_businesses = len(businesses)

    active_businesses = sum(
        1 for b in businesses
        if bool(b.active) and not bool(b.suspended)
    )

    trial_businesses = sum(
        1 for b in businesses
        if (b.subscription_status or "").lower() == "trialing"
        and not bool(b.suspended)
    )

    paid_businesses = sum(
        1 for b in businesses
        if (b.subscription_status or "").lower() == "active"
        and not bool(b.suspended)
    )

    suspended_businesses = sum(
        1 for b in businesses
        if bool(b.suspended)
    )

    pending_verification = sum(
        1 for b in businesses
        if (b.verification_status or "pending").lower() == "pending"
    )

    total_users = User.query.count()
    total_orders = Order.query.count()

    paid_orders = (
        Order.query
        .filter(
            db.func.lower(
                db.func.coalesce(Order.payment_status, "")
            ) == "paid"
        )
        .limit(10000)
        .all()
    )

    order_gmv = sum(float(order.total or 0) for order in paid_orders)

    paid_subscription_payments = (
        SubscriptionPayment.query
        .filter(
            db.func.lower(
                db.func.coalesce(SubscriptionPayment.status, "")
            ).in_(["paid", "complete", "completed", "success", "successful"])
        )
        .limit(10000)
        .all()
    )

    subscription_revenue = sum(
        float(payment.amount or 0)
        for payment in paid_subscription_payments
    )

    analytics_events = AnalyticsEvent.query.count()

    unique_visitors = (
        db.session.query(
            db.func.count(
                db.func.distinct(AnalyticsEvent.visitor_id)
            )
        )
        .scalar()
        or 0
    )

    recent_orders = (
        Order.query
        .order_by(Order.id.desc())
        .limit(12)
        .all()
    )

    return render_template(
        "admin.html",
        businesses=businesses,
        recent_orders=recent_orders,
        total_businesses=total_businesses,
        active_businesses=active_businesses,
        trial_businesses=trial_businesses,
        paid_businesses=paid_businesses,
        suspended_businesses=suspended_businesses,
        pending_verification=pending_verification,
        total_users=total_users,
        total_orders=total_orders,
        order_gmv=order_gmv,
        subscription_revenue=subscription_revenue,
        analytics_events=analytics_events,
        unique_visitors=unique_visitors,
    )


