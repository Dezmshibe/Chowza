MAX_LOGIN_ATTEMPTS = 5
LOGIN_LOCK_MINUTES = 15
MAX_LOGIN_USERNAME_LENGTH = 100
MAX_LOGIN_PASSWORD_LENGTH = 128

# Failed attempts are stored temporarily in memory.
#
# Structure:
# {
#     "ip:username": [
#         datetime(...),
#         datetime(...)
#     ]
# }
LOGIN_ATTEMPTS = {}

# Active temporary login locks.
#
# Structure:
# {
#     "ip:username": datetime(...)
# }
LOGIN_LOCKS = {}


def get_client_ip():
    """Return the client IP after ProxyFix has processed trusted proxy headers."""
    return request.remote_addr or "unknown"


def get_login_attempt_key(username):
    """
    Create a login attempt key using the client IP and username.
    """

    username = str(username or "").lower().strip()

    client_ip = get_client_ip()

    return f"{client_ip}:{username}"


def is_login_locked(username):
    """
    Check whether this IP + username combination is temporarily locked.
    """

    key = get_login_attempt_key(username)

    lock_until = LOGIN_LOCKS.get(key)

    if not lock_until:
        return False, 0

    now = utc_now()

    if now >= lock_until:

        LOGIN_LOCKS.pop(
            key,
            None
        )

        LOGIN_ATTEMPTS.pop(
            key,
            None
        )

        return False, 0

    remaining_seconds = max(
        0,
        int(
            (lock_until - now).total_seconds()
        )
    )

    remaining_minutes = max(
        1,
        (remaining_seconds + 59) // 60
    )

    return True, remaining_minutes


def record_failed_login(username):
    """
    Record a failed login attempt.

    Returns True when the maximum number of attempts has been reached
    and the login is now temporarily locked.
    """

    key = get_login_attempt_key(username)

    now = utc_now()

    window_start = (
        now
        - timedelta(
            minutes=LOGIN_LOCK_MINUTES
        )
    )

    attempts = LOGIN_ATTEMPTS.get(
        key,
        []
    )

    # Keep only recent attempts.
    attempts = [
        attempt_time
        for attempt_time in attempts
        if attempt_time > window_start
    ]

    attempts.append(now)

    LOGIN_ATTEMPTS[key] = attempts

    if len(attempts) >= MAX_LOGIN_ATTEMPTS:

        LOGIN_LOCKS[key] = (
            now
            + timedelta(
                minutes=LOGIN_LOCK_MINUTES
            )
        )

        LOGIN_ATTEMPTS.pop(
            key,
            None
        )

        return True

    return False


def clear_login_attempts(username):
    """
    Clear failed attempts and locks after a successful login.
    """

    key = get_login_attempt_key(username)

    LOGIN_ATTEMPTS.pop(
        key,
        None
    )

    LOGIN_LOCKS.pop(
        key,
        None
    )
