        safe_log("WHATSAPP CUSTOMER STATUS SKIPPED: invalid customer phone")
        return False

    business_name = (
        getattr(business, "business_name", "")
        or getattr(business, "name", "")
        or "the business"
    )

    status_messages = {
        "Pending": "We have received your order and it is waiting to be confirmed.",
        "Confirmed": "Your order has been confirmed by the business.",
        "Preparing": "Your order is now being prepared.",
        "Ready": "Your order is ready for collection.",
        "Out for Delivery": "Your order is out for delivery.",
        "Completed": "Your order has been completed. Thank you for ordering!",
        "Cancelled": "Unfortunately, your order has been cancelled by the business.",
    }

    message = status_messages.get(
        order.status,
        f"Your order status is now {order.status}."
    )

    prep_line = ""
    if order.status == "Preparing" and order.estimated_prep_minutes:
        prep_line = (
            f"\nEstimated preparation time: "
            f"{order.estimated_prep_minutes} minutes"
        )

    text = "\n".join([
        f"Order #{safe_order_number} update",
        "",
        f"Hi {order.customer_name},",
        f"{message}",
        prep_line,
        "",
        f"Business: {business_name}",
        f"Status: {order.status}",
        "",
        "Thank you for using Chowza."
    ])

    safe_log("WHATSAPP CUSTOMER STATUS RECIPIENT:", mask_phone_for_log(customer_phone))

    return send_whatsapp_message(
        customer_phone,
        text
    )


