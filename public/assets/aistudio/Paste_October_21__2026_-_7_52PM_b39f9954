MAX_JSON_BYTES = 256 * 1024
MAX_ANALYTICS_BYTES = 16 * 1024
MAX_CART_ITEMS = 50
MAX_ITEM_QUANTITY = 50
MAX_CUSTOMER_NAME_LENGTH = 100
MAX_CUSTOMER_NOTE_LENGTH = 500
MAX_ADDRESS_LENGTH = 300
MAX_PROMOTION_CODE_LENGTH = 64


def json_request_object(max_bytes=MAX_JSON_BYTES):
    """Return a validated JSON object or (None, error_response)."""
    if not request.is_json:
        return None, (jsonify({
            "success": False,
            "message": "Content-Type must be application/json."
        }), 415)

    content_length = request.content_length
    if content_length is not None and content_length > max_bytes:
        return None, (jsonify({
            "success": False,
            "message": "Request is too large."
        }), 413)

    data = request.get_json(silent=True)
    if not isinstance(data, dict):
        return None, (jsonify({
            "success": False,
            "message": "A JSON object is required."
        }), 400)

    return data, None


def parse_positive_int(value, *, minimum=1, maximum=None):
    """Parse an integer without accepting booleans or fractional values."""
    if isinstance(value, bool):
        raise ValueError("boolean is not an integer")
    if isinstance(value, float) and not value.is_integer():
        raise ValueError("fractional value")
    parsed = int(value)
    if parsed < minimum:
        raise ValueError("below minimum")
    if maximum is not None and parsed > maximum:
        raise ValueError("above maximum")
    return parsed


def clean_text(value, *, max_length, field_name, required=False):
    """Normalise a user string and enforce a strict length limit."""
    if value is None:
        value = ""
    if not isinstance(value, str):
        value = str(value)
    value = value.strip()
    if required and not value:
        raise ValueError(f"{field_name} is required")
    if len(value) > max_length:
        raise ValueError(f"{field_name} is too long")
    return value


def finite_money(value, *, minimum=Decimal("0"), maximum=Decimal("1000000")):
    """Parse a finite monetary value without accepting NaN/Infinity."""
    try:
        amount = Decimal(str(value))
    except (InvalidOperation, TypeError, ValueError):
        raise ValueError("invalid monetary value")
    if not amount.is_finite():
        raise ValueError("non-finite monetary value")
    if amount < minimum or amount > maximum:
        raise ValueError("monetary value out of range")
    return amount.quantize(Decimal("0.01"))


def valid_order_number(value):
    """Order numbers are opaque identifiers; keep lookups bounded."""
    value = str(value or "").strip().lstrip("#").strip()
    if not value or len(value) > 64:
        return ""
    if not re.fullmatch(r"[A-Za-z0-9_-]+", value):
        return ""
    return value


