ANALYTICS_VISITOR_COOKIE = "wf_visitor_id"
ANALYTICS_SESSION_COOKIE = "wf_session_id"


def get_or_create_analytics_ids():
    """
    Create anonymous analytics identifiers.

    These identifiers do not contain:
    - customer names
    - phone numbers
    - addresses
    - passwords
    - business login information
    """

    visitor_id = request.cookies.get(
        ANALYTICS_VISITOR_COOKIE
    )

    session_id = request.cookies.get(
        ANALYTICS_SESSION_COOKIE
    )

    if not visitor_id:
        visitor_id = uuid.uuid4().hex

    if not session_id:
        session_id = uuid.uuid4().hex

    return visitor_id, session_id


def detect_device_type():
    """
    Classify the visitor's device using the browser
    User-Agent.

    This stores only a broad category.
    """

    user_agent = (
        request.headers.get(
            "User-Agent",
            ""
        )
        .lower()
    )

    if not user_agent:
        return "unknown"

    if "tablet" in user_agent:
        return "tablet"

    mobile_keywords = [
        "mobile",
        "android",
        "iphone",
        "ipod"
    ]

    if any(
        keyword in user_agent
        for keyword in mobile_keywords
    ):
        return "mobile"

    return "desktop"


def track_analytics_event(
    event_type,
    business_id=None,
    food_id=None
):
    """
    Record one anonymous analytics event.

    This function deliberately does NOT store:
    - IP addresses
    - customer names
    - phone numbers
    - delivery addresses
    - passwords
    """

    if not event_type:
        return False

    visitor_id, session_id = (
        get_or_create_analytics_ids()
    )

    path = request.path or ""

    referrer = (
        request.referrer or ""
    )

    # Prevent unnecessarily large values.
    path = path[:500]
    referrer = referrer[:500]

    event = AnalyticsEvent(
        visitor_id=visitor_id,
        session_id=session_id,
        event_type=str(
            event_type
        )[:50],
        business_id=business_id,
        food_id=food_id,
        path=path,
        referrer=referrer,
        device_type=detect_device_type(),
        created_at=utc_now()
    )

    try:

        db.session.add(event)

        db.session.commit()

        return True

    except Exception as exc:

        db.session.rollback()

        safe_log(
            "ANALYTICS EVENT ERROR:",
            repr(exc)
        )

        return False
