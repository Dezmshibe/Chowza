def run_final_security_regression_checks():
    """Run deterministic startup checks; never call external providers."""
    required_routes = {
        "place_order", "track_order", "live_order_status", "cancel_order",
        "yoco_webhook", "whatsapp_webhook", "payfast_webhook",
        "billing_webhook", "admin", "dashboard", "manage_business",
    }
    endpoint_names = {rule.endpoint for rule in app.url_map.iter_rules()}
    missing = required_routes - endpoint_names
    if missing:
        raise RuntimeError("Security regression check failed: required endpoint missing.")

    if app.config.get("SESSION_COOKIE_HTTPONLY") is not True:
        raise RuntimeError("Security regression check failed: session cookie is not HttpOnly.")
    if app.config.get("SESSION_COOKIE_SAMESITE") != "Lax":
        raise RuntimeError("Security regression check failed: session SameSite policy changed.")
    if DATABASE_URL and app.config.get("SESSION_COOKIE_SECURE") is not True:
        raise RuntimeError("Security regression check failed: production session cookie is not Secure.")
    if DATABASE_URL and DEBUG:
        raise RuntimeError("Security regression check failed: production debug mode is enabled.")

    if not callable(globals().get("encrypt_sensitive_value")) or not callable(globals().get("decrypt_sensitive_value")):
        raise RuntimeError("Security regression check failed: credential encryption helpers are missing.")

    safe_log("CHOWZA SECURITY HARDENING PASSES 1-25 ACTIVE")


def validate_order_status_transition(current_status, new_status):
    current = str(current_status or "Pending").strip()
    new = str(new_status or "").strip()
    return new in ORDER_STATUS_TRANSITIONS.get(current, {current})


def set_order_status_safely(order, new_status):
    new_status = str(new_status or "").strip()
    if not validate_order_status_transition(order.status, new_status):
        raise ValueError(f"Order cannot move from {order.status} to {new_status}.")
    order.status = new_status


def set_payment_status_safely(order, new_status):
    new_status = str(new_status or "").strip()
    current = str(order.payment_status or "Awaiting Payment").strip()
    if new_status not in PAYMENT_STATUS_TRANSITIONS.get(current, {current}):
        raise ValueError(f"Payment cannot move from {current} to {new_status}.")
    order.payment_status = new_status


def lock_row(query):
    """Use row-level locking on PostgreSQL; stay compatible with SQLite."""
    if db.engine.url.get_backend_name() != "sqlite":
        return query.with_for_update().first()
    return query.first()


def lock_business_for_update(business_id):
    """Load a business with a PostgreSQL row lock for critical state changes."""
    query = Business.query.filter(Business.id == business_id)
    if db.engine.url.get_backend_name() != "sqlite":
        return query.with_for_update().first()
    return query.first()


