# ============================================================
# PAYFAST ITN WEBHOOK
# ============================================================

def payfast_source_ip_is_valid(
    remote_addr
):
    """
    Validate the incoming PayFast request against the
    currently published PayFast notification hosts.

    PayFast documents these hostnames and notes that their
    A records can change, so the addresses are resolved at
    runtime instead of permanently hard-coded.
    """

    if not remote_addr:
        return False

    source = str(
        remote_addr
    ).strip()

    if source.startswith("::ffff:"):
        source = source[7:]

    for host in PAYFAST_ITN_HOSTS:

        try:
            addresses = {
                item[4][0]
                for item in socket.getaddrinfo(
                    host,
                    443,
                    type=socket.SOCK_STREAM
                )
            }

        except socket.gaierror:
            continue

        if source in addresses:
            return True

    return False

def payfast_itn_signature(data, passphrase=None):
    """Generate the PayFast ITN signature exactly as documented."""

    parts = []

    for key, value in data.items():

        if key == "signature":
            break

        if value is None:
            value = ""

        encoded_value = quote_plus(
            str(value),
            safe=""
        ).replace("~", "%7E")

        parts.append(
            f"{key}={encoded_value}"
        )

    parameter_string = "&".join(parts)

    if passphrase is not None and str(passphrase) != "":
        encoded_passphrase = quote_plus(
            str(passphrase).strip(),
            safe=""
        ).replace("~", "%7E")

        parameter_string += (
            "&passphrase="
            + encoded_passphrase
        )

    return hashlib.md5(
        parameter_string.encode("utf-8")
    ).hexdigest()

def payfast_itn_signature_from_raw_body(
    raw_body,
    passphrase=None
):
    """
    Generate the PayFast ITN signature using the exact
    URL-encoded parameter order received from PayFast.

    Using the raw POST body prevents Flask's form parser
    from changing the ordering or encoding used by PayFast.
    """

    if isinstance(raw_body, bytes):
        raw_body = raw_body.decode(
            "utf-8",
            errors="strict"
        )

    parts = []

    for pair in raw_body.split("&"):

        if not pair:
            continue

        key, separator, raw_value = pair.partition("=")

        if not separator:
            continue

        decoded_key = unquote_plus(key)

        if decoded_key == "signature":
            break

        if raw_value == "":
            continue

        # PayFast has already URL-encoded the value in the
        # raw POST body. Preserve that exact representation.
        parts.append(
            f"{key}={raw_value}"
        )

    parameter_string = "&".join(parts)

    if passphrase:
        parameter_string += (
            "&passphrase="
            + quote_plus(
                str(passphrase).strip(),
                safe=""
            )
        )

    return hashlib.md5(
        parameter_string.encode("utf-8")
    ).hexdigest()

def payfast_itn_signature_is_valid(
    data
):
    supplied = str(
        data.get("signature", "")
    ).strip().lower()

    if not supplied:
        return False

    expected = payfast_itn_signature(
        data,
        PAYFAST_PASSPHRASE
    ).lower()

    if not hmac.compare_digest(
        expected,
        supplied
    ):
        safe_log(
            "PAYFAST ITN SIGNATURE MISMATCH:",
            "expected=", expected,
            "supplied=", supplied
        )
        return False

    return True


def validate_payfast_itn_with_payfast(
    data
):
    """
    Perform PayFast's server-to-server ITN validation.

    PayFast expects the same posted parameters to be sent
    to its validation endpoint.
    """

    validation_data = {
        key: value
        for key, value in data.items()
        if key != "signature"
    }

    try:
        response = outbound_request(
            "POST",
            PAYFAST_VALIDATE_URL,
            data=validation_data,
            timeout=20,
        )

    except requests.RequestException as exc:
        safe_log(
            "PAYFAST ITN VALIDATION REQUEST ERROR:",
            repr(exc)
        )
        return False

    return (
        response.status_code == 200
        and response.text.strip().upper()
        == "VALID"
    )


def parse_payfast_billing_datetime(
    value
):
    if not value:
        return None

    text_value = str(
        value
    ).strip()

    try:
        result = datetime.strptime(
            text_value,
            "%Y-%m-%d"
        ).replace(
            tzinfo=timezone.utc
        )

        return result

    except ValueError:
        pass

    try:
        result = datetime.fromisoformat(
            text_value.replace(
                "Z",
                "+00:00"
            )
        )

        if result.tzinfo is None:
            result = result.replace(
                tzinfo=timezone.utc
            )

        return result

    except ValueError:
        return None


def handle_payfast_itn(
    data,
    raw_body=None
):
    """
    Process one verified PayFast ITN idempotently.

    Initial payment:
        Updates the pending SubscriptionPayment.

    Recurring payment:
        Creates a new SubscriptionPayment history row.

    Both:
        Update the Business subscription state.
    """

    merchant_id = str(
        data.get("merchant_id", "")
    ).strip()

    if (
        not PAYFAST_MERCHANT_ID
        or merchant_id != PAYFAST_MERCHANT_ID
    ):
        raise ValueError(
            "PayFast merchant ID mismatch."
        )

    if not payfast_itn_signature_is_valid(data):
        raise ValueError(
            "Invalid PayFast ITN signature."
        )

    if not payfast_source_ip_is_valid(
        request.remote_addr
    ):
        raise ValueError(
            "Invalid PayFast source address."
        )

    if not validate_payfast_itn_with_payfast(
        data
    ):
        raise ValueError(
            "PayFast ITN server validation failed."
        )

    status = str(
        data.get(
            "payment_status",
            ""
        )
    ).strip().upper()

    m_payment_id = str(
        data.get(
            "m_payment_id",
            ""
        )
    ).strip()

    pf_payment_id = str(
        data.get(
            "pf_payment_id",
            ""
        )
    ).strip()

    if (
        not m_payment_id
        or not pf_payment_id
    ):
        raise ValueError(
            "PayFast payment identifiers are missing."
        )

    prefix = "chowza-subscription-"

    if not m_payment_id.startswith(
        prefix
    ):
        raise ValueError(
            "Unknown Chowza PayFast payment ID."
        )

    try:
        local_payment_id = int(
            m_payment_id[
                len(prefix):
            ]
        )

    except ValueError:
        raise ValueError(
            "Invalid Chowza PayFast payment ID."
        )

    payment = lock_row(
        SubscriptionPayment.query.filter(SubscriptionPayment.id == local_payment_id)
    )

    if not payment:
        raise ValueError(
            "Subscription payment does not exist."
        )

    if payment.provider != "payfast":
        raise ValueError(
            "Subscription payment provider mismatch."
        )

    # Every ITN contains the gross amount. It must match
    # the amount Chowza requested.
    try:
        expected_amount = float(
            payment.amount
        )

        received_amount = float(
            data.get(
                "amount_gross",
                0
            )
        )

    except (TypeError, ValueError):
        raise ValueError(
            "Invalid PayFast payment amount."
        )

    if abs(
        expected_amount
        - received_amount
    ) > 0.01:
        raise ValueError(
            "PayFast amount mismatch."
        )

    # PayFast can retry the same ITN. Do not record
    # the same pf_payment_id twice.
    existing = (
        SubscriptionPayment.query
        .filter_by(
            provider_payment_id=
                pf_payment_id
        )
        .first()
    )

    if existing:
        return

    business = lock_row(
        Business.query.filter(Business.id == payment.business_id)
    )

    if not business:
        raise ValueError(
            "Business for subscription payment "
            "does not exist."
        )

    now = utc_now()

    if status == "CANCELLED":

        if not payment.provider_payment_id:
            payment.provider_payment_id = (
                pf_payment_id
            )

        payment.status = "cancelled"

        business.subscription_status = (
            "cancelled"
        )
        business.subscription_payment_status = (
            "cancelled"
        )
        business.subscription_cancelled_at = now
        business.subscription_cancel_at_period_end = (
            False
        )
        business.subscription_next_payment_at = None
        business.active = False

        db.session.commit()

        return

    if status != "COMPLETE":
        # Unknown/non-complete notification.
        # Do not activate or change the subscription.
        return

    token = str(
        data.get(
            "token",
            ""
        )
    ).strip()

    if not token:
        raise ValueError(
            "PayFast subscription token is missing."
        )

    billing_date = (
        parse_payfast_billing_datetime(
            data.get(
                "billing_date"
            )
        )
        or now
    )

    # The first payment updates the original pending record.
    initial_payment = (
        payment.status == "pending"
        and not payment.provider_payment_id
    )

    if initial_payment:

        target_payment = payment

    else:

        # A later recurring charge uses the same m_payment_id
        # but has a new pf_payment_id. Record it separately.
        target_payment = SubscriptionPayment(
            business_id=business.id,
            plan=payment.plan,
            amount=payment.amount,
            currency="ZAR",
            provider="payfast",
            provider_payment_id=pf_payment_id,
            status="pending",
        )

        db.session.add(
            target_payment
        )

    # Chowza keeps the subscription period locally.
    # PayFast ITN billing_date is used as the period start,
    # and the subscription period ends one month later.
    period_end = add_one_month(
        billing_date
    )

    target_payment.status = "paid"
    target_payment.provider_payment_id = (
        pf_payment_id
    )
    target_payment.paid_at = now
    target_payment.billing_period_start = (
        billing_date
    )
    target_payment.billing_period_end = (
        period_end
    )

    business.plan = payment.plan
    business.active = True
    business.subscription_provider = "payfast"
    business.subscription_status = "active"
    business.subscription_started_at = (
        business.subscription_started_at
        or now
    )
    business.subscription_current_period_start = (
        billing_date
    )
    business.subscription_current_period_end = (
        period_end
    )
    business.subscription_next_payment_at = (
        period_end
    )
    business.subscription_last_payment_at = (
        now
    )
    business.subscription_payment_status = (
        "paid"
    )
    business.subscription_cancel_at_period_end = (
        False
    )
    business.subscription_cancelled_at = None
    business.subscription_id = token

    db.session.commit()


@limiter.limit("30 per minute")
@app.route(
    "/webhooks/payfast",
    methods=["POST"]
)
@csrf.exempt
def payfast_webhook():
    """
    PayFast Instant Transaction Notification endpoint.

    PayFast requires a public notify URL. Chowza validates the
    signature, source, amount and PayFast server confirmation
    before changing subscription state.
    """

    try:
        raw_body = request.get_data(cache=True)

        ordered_items = list(
            request.form.items(
                multi=False
            )
        )

        data = dict(
            ordered_items
        )

        if not data:
            return (
                "Invalid PayFast notification.",
                400
            )

        handle_payfast_itn(
            data,
            raw_body
        )

        return "OK", 200
    except ValueError as exc:
        safe_log(
            "PAYFAST ITN REJECTED:",
            str(exc)
        )

        return (
            "Invalid notification.",
            400
        )

    except Exception as exc:

        db.session.rollback()

        safe_log(
            "PAYFAST ITN ERROR:",
            repr(exc)
        )

        return (
            "Temporary processing error.",
            500
        )
