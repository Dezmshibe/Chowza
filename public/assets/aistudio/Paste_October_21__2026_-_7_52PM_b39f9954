def create_business_slug(business_name):

    slug = re.sub(
        r"[^a-z0-9]+",
        "-",
        business_name.lower()
    ).strip("-")

    if not slug:
        slug = "business"

    original = slug
    counter = 2

    while Business.query.filter_by(slug=slug).first():

        slug = original + "-" + str(counter)

        counter += 1

    return slug

