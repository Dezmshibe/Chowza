@app.route("/analytics")
@business_owner_required
@login_required
@requires_feature("basic_analytics")
def analytics_dashboard():

    # --------------------------------------------------------
    # Make sure the logged-in user belongs to a business
    # --------------------------------------------------------

    if not current_user.business_id:

        flash(
            "This account is not connected to a business."
        )

        return redirect(
            url_for("dashboard")
        )


    # --------------------------------------------------------
    # Get the user's business
    # --------------------------------------------------------

    business = db.session.get(
        Business,
        current_user.business_id
    )

    if not business:

        flash(
            "Business not found."
        )

        return redirect(
            url_for("dashboard")
        )


    # --------------------------------------------------------
    # Analytics period
    #
    # Supported:
    # 7 days
    # 30 days
    # 90 days
    # All time
    # --------------------------------------------------------

    period = (
        request.args.get(
            "period",
            "30"
        )
        .strip()
        .lower()
    )


    allowed_periods = {
        "7",
        "30",
        "90",
        "all"
    }


    if period not in allowed_periods:

        period = "30"


    # --------------------------------------------------------
    # Current time
    # --------------------------------------------------------

    end_date = datetime.utcnow()


    # --------------------------------------------------------
    # Calculate start date
    # --------------------------------------------------------

    if period == "7":

        start_date = (
            end_date
            - timedelta(days=7)
        )

        date_range_label = "Last 7 Days"


    elif period == "90":

        start_date = (
            end_date
            - timedelta(days=90)
        )

        date_range_label = "Last 90 Days"


    elif period == "all":

        start_date = None

        date_range_label = "All Time"


    else:

        start_date = (
            end_date
            - timedelta(days=30)
        )

        date_range_label = "Last 30 Days"


    # --------------------------------------------------------
    # Get analytics events for this business
    # --------------------------------------------------------

    analytics_query = (
        AnalyticsEvent.query
        .filter(
            AnalyticsEvent.business_id
            == business.id
        )
    )


    if start_date is not None:

        analytics_query = analytics_query.filter(
            AnalyticsEvent.created_at
            >= start_date
        )


    analytics_query = analytics_query.filter(
        AnalyticsEvent.created_at
        <= end_date
    )


    events = (
        analytics_query
        .order_by(
            AnalyticsEvent.created_at.asc()
        )
        .limit(10000)
        .all()
    )


    # --------------------------------------------------------
    # Visitors
    #
    # Count unique anonymous visitors
    # --------------------------------------------------------

    unique_visitors = {
        event.visitor_id
        for event in events
        if event.visitor_id
    }


    visitors = len(
        unique_visitors
    )


    # --------------------------------------------------------
    # Funnel events
    # --------------------------------------------------------

    menu_views = sum(
        1
        for event in events
        if event.event_type
        == "menu_view"
    )


    add_to_cart = sum(
        1
        for event in events
        if event.event_type
        == "add_to_cart"
    )


    checkout_started = sum(
        1
        for event in events
        if event.event_type
        == "checkout_started"
    )


    # --------------------------------------------------------
    # Get actual orders
    #
    # Orders are taken from the Order table rather than
    # relying only on browser analytics.
    # --------------------------------------------------------

    orders_query = (
        Order.query
        .filter(
            Order.business_id
            == business.id
        )
    )


    if start_date is not None:

        orders_query = orders_query.filter(
            Order.created_at
            >= start_date
        )


    orders_query = orders_query.filter(
        Order.created_at
        <= end_date
    )


    orders = (
        orders_query
        .order_by(
            Order.created_at.desc()
        )
        .limit(5000)
        .all()
    )


    orders_count = len(
        orders
    )


    # --------------------------------------------------------
    # Completed orders
    # --------------------------------------------------------

    completed_orders_list = [

        order

        for order in orders

        if str(
            order.status
        ).strip().lower()
        == "completed"

    ]


    completed_orders = len(
        completed_orders_list
    )


    # --------------------------------------------------------
    # Revenue
    #
    # Revenue shown here is the value of completed orders.
    # --------------------------------------------------------

    revenue = sum(

        float(
            order.total or 0
        )

        for order
        in completed_orders_list

    )


    # --------------------------------------------------------
    # Conversion calculations
    # --------------------------------------------------------

    def conversion_rate(
        numerator,
        denominator
    ):

        if not denominator:
            return 0

        return round(
            (
                numerator
                / denominator
            ) * 100,
            1
        )


    visitor_to_menu = conversion_rate(
        menu_views,
        visitors
    )


    menu_to_cart = conversion_rate(
        add_to_cart,
        menu_views
    )


    cart_to_checkout = conversion_rate(
        checkout_started,
        add_to_cart
    )


    checkout_to_order = conversion_rate(
        orders_count,
        checkout_started
    )


    order_to_completed = conversion_rate(
        completed_orders,
        orders_count
    )


    # --------------------------------------------------------
    # Device breakdown
    #
    # One visitor is counted once.
    # --------------------------------------------------------

    device_visitors = {}


    for event in events:

        visitor_id = (
            event.visitor_id
        )


        if not visitor_id:
            continue


        device = (
            event.device_type
            or "unknown"
        )


        if visitor_id not in device_visitors:

            device_visitors[
                visitor_id
            ] = device


    device_breakdown = {}


    for device in (
        device_visitors.values()
    ):

        device_breakdown[device] = (
            device_breakdown.get(
                device,
                0
            ) + 1
        )


    # --------------------------------------------------------
    # Top ordered menu items
    # --------------------------------------------------------

    item_totals = {}


    for order in orders:

        order_items = get_order_items(
            order
        )


        for item in order_items:

            if not isinstance(
                item,
                dict
            ):

                continue


            item_name = str(
                item.get(
                    "name",
                    "Unknown Item"
                )
            ).strip()


            if not item_name:

                item_name = (
                    "Unknown Item"
                )


            try:

                quantity = int(
                    item.get(
                        "quantity",
                        1
                    )
                )

            except (
                TypeError,
                ValueError
            ):

                quantity = 1


            if quantity < 1:

                quantity = 1


            item_totals[item_name] = (
                item_totals.get(
                    item_name,
                    0
                )
                + quantity
            )


    top_items = sorted(
        item_totals.items(),
        key=lambda item: item[1],
        reverse=True
    )[:10]


    # --------------------------------------------------------
    # DAILY ANALYTICS
    # --------------------------------------------------------

    daily_stats = {}

    # Create date buckets from the selected period
    if start_date is not None:

        current_day = start_date.date()

    else:

        if events or orders:

            all_dates = []

            for event in events:

                if event.created_at:
                    all_dates.append(
                        event.created_at.date()
                    )

            for order in orders:

                if order.created_at:
                    all_dates.append(
                        order.created_at.date()
                    )

            if all_dates:

                current_day = min(all_dates)

            else:

                current_day = end_date.date()

        else:

            current_day = end_date.date()


    final_day = end_date.date()


    # Build daily buckets
    while current_day <= final_day:

        date_key = current_day.isoformat()

        daily_stats[date_key] = {
            "visitors": set(),
            "menu_views": 0,
            "orders": 0,
            "revenue": 0
        }

        current_day += timedelta(days=1)


    # --------------------------------------------------------
    # Add analytics events to daily buckets
    # --------------------------------------------------------

    for event in events:

        if not event.created_at:
            continue

        date_key = (
            event.created_at.date().isoformat()
        )

        if date_key not in daily_stats:
            continue

        if event.event_type == "menu_view":

            daily_stats[
                date_key
            ]["menu_views"] += 1


        if event.visitor_id:

            daily_stats[
                date_key
            ]["visitors"].add(
                event.visitor_id
            )


    # --------------------------------------------------------
    # Add orders to daily buckets
    # --------------------------------------------------------

    for order in orders:

        if not order.created_at:
            continue

        date_key = (
            order.created_at.date().isoformat()
        )

        if date_key not in daily_stats:
            continue

        daily_stats[
            date_key
        ]["orders"] += 1


        if (
            str(order.status)
            .strip()
            .lower()
            == "completed"
        ):

            daily_stats[
                date_key
            ]["revenue"] += float(
                order.total or 0
            )


    # --------------------------------------------------------
    # Convert sets into numbers for the template
    # --------------------------------------------------------

    chart_dates = []
    chart_visitors = []
    chart_orders = []
    chart_revenue = []


    for date_key in sorted(
        daily_stats.keys()
    ):

        chart_dates.append(
            date_key
        )

        chart_visitors.append(
            len(
                daily_stats[
                    date_key
                ]["visitors"]
            )
        )

        chart_orders.append(
            daily_stats[
                date_key
            ]["orders"]
        )

        chart_revenue.append(
            round(
                daily_stats[
                    date_key
                ]["revenue"],
                2
            )
        )


    # --------------------------------------------------------
    # Render analytics page
    # --------------------------------------------------------

    return render_template(

        "analytics.html",

        business=business,

        period=period,

        date_range_label=(
            date_range_label
        ),

        visitors=visitors,

        menu_views=menu_views,

        add_to_cart=add_to_cart,

        checkout_started=(
            checkout_started
        ),

        orders_count=orders_count,

        completed_orders=(
            completed_orders
        ),

        revenue=revenue,

        visitor_to_menu=(
            visitor_to_menu
        ),

        menu_to_cart=(
            menu_to_cart
        ),

        cart_to_checkout=(
            cart_to_checkout
        ),

        checkout_to_order=(
            checkout_to_order
        ),

        order_to_completed=(
            order_to_completed
        ),

        device_breakdown=(
            device_breakdown
        ),

        top_items=top_items,

        chart_dates=chart_dates,
        chart_visitors=chart_visitors,
        chart_orders=chart_orders,
        chart_revenue=chart_revenue
    )  
