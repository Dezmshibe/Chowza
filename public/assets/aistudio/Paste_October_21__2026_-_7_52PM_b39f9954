@limiter.limit("5 per hour", methods=["POST"])
@app.route("/register-business", methods=["GET", "POST"])
def register_business():

    requested_plan = (
        request.args.get("plan", "")
        or request.form.get("plan", "")
    ).strip().lower()

    if requested_plan not in PLANS:
        requested_plan = DEFAULT_PLAN

    if request.method == "GET":
        return render_template(
            "register_business.html",
            selected_plan=requested_plan,
            plan=PLANS[requested_plan],
            plans=PLANS,
            trial_days=TRIAL_DAYS,
        )
    business_name = request.form.get(
        "business_name",
        ""
    ).strip()

    category = request.form.get(
        "category",
        ""
    ).strip()

    owner_name = request.form.get(
        "owner_name",
        ""
    ).strip()

    whatsapp_raw = request.form.get(
        "whatsapp_number",
        ""
    ).strip()

    username = request.form.get(
        "username",
        ""
    ).strip()

    # Usernames are case-insensitive for authentication and ownership.
    username_lookup = username.casefold()

    password = request.form.get(
        "password",
        ""
    )

    confirm_password = request.form.get(
        "confirm_password",
        ""
    )

    if not business_name:
        flash("Business name is required.")
        return redirect(
            url_for("register_business")
        )
    if not category:
        flash("Please select a business category.")
        return redirect(
            url_for("register_business")
        )

    if len(category) > 100:
        flash("Business category is too long.")
        return redirect(
            url_for("register_business")
        )

    if len(business_name) > 150:

        flash("Business name is too long.")
        return redirect(url_for("register_business"))

    if not owner_name:
        flash("Owner name is required.")
        return redirect(url_for("register_business"))

    if len(owner_name) > 150:
        flash("Owner name is too long.")
        return redirect(url_for("register_business"))

    if not whatsapp_raw:
        flash("WhatsApp number is required.")
        return redirect(url_for("register_business"))

    whatsapp = normalize_phone(whatsapp_raw)

    if len(whatsapp) < 10 or len(whatsapp) > 20:
        flash("Please enter a valid WhatsApp number.")
        return redirect(url_for("register_business"))

    if not username:
        flash("Username is required.")
        return redirect(url_for("register_business"))

    if len(username) < 3 or len(username) > 100:
        flash("Username must be between 3 and 100 characters.")
        return redirect(url_for("register_business"))

    if not re.fullmatch(r"[A-Za-z0-9._-]+", username):
        flash("Username may contain only letters, numbers, dots, underscores, and hyphens.")
        return redirect(url_for("register_business"))

    password_valid, password_error = validate_password(password)

    if not password_valid:
        flash(password_error)
        return redirect(url_for("register_business"))

    if password != confirm_password:
        flash("Passwords do not match.")
        return redirect(url_for("register_business"))

    if User.query.filter(
        db.func.lower(User.username) == username_lookup
    ).first():
        flash("That username is already taken.")
        return redirect(url_for("register_business"))

    if Business.query.filter_by(whatsapp_number=whatsapp).first():
        flash("That WhatsApp number is already registered.")
        return redirect(url_for("register_business"))

    slug = create_business_slug(business_name)

    # --------------------------------------------------------
    # SUBSCRIPTION PLAN + 14-DAY TRIAL
    # --------------------------------------------------------
    now = utc_now()

    business = Business(
        name=business_name,
        business_name=business_name,
        category=category,
        owner_name=owner_name,
        phone=whatsapp,
        whatsapp_number=whatsapp,
        slug=slug,
        active=True,
        is_open=True,
        plan=requested_plan,
        subscription_status="trialing",
        trial_ends_at=now + timedelta(days=TRIAL_DAYS),
        subscription_started_at=None,
    )

    user = User(
        username=username,
        password_hash=generate_password_hash(password)
    )

    try:
        db.session.add(business)
        db.session.flush()
        user.business_id = business.id
        db.session.add(user)
        db.session.commit()
    except Exception as e:
        db.session.rollback()
        safe_log("REGISTRATION ERROR:", repr(e))
        flash("Could not create the business. The username, WhatsApp number, or business URL may already be in use.")
        return redirect(url_for("register_business"))

    flash(f"Business registered successfully! Your {PLANS[requested_plan]['name']} plan includes a {TRIAL_DAYS}-day free trial. You can now log in.")
    return redirect(url_for("business_login"))


