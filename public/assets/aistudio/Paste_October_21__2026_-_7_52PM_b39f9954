# ============================================================
# CUSTOMER-INITIATED ORDER CANCELLATION
# ============================================================
# NEW FEATURE: previously a customer had no way to back out of
# an order once placed  they'd have to contact the vendor
# directly. This lets them cancel their own order from the
# tracking page, but only while it's still Pending/Confirmed
# (not once it's being prepared or delivered), and only if they
# can prove ownership with the same order number + phone number
# used to place it.

@limiter.limit("10 per minute")
@app.route("/cancel-order", methods=["POST"])
def cancel_order():

    order_id = request.form.get("order_id", "").strip()
    phone = request.form.get("phone", "").strip()

    cleaned_order_number = valid_order_number(order_id)
    normalized_phone = normalize_phone(phone)

    if not cleaned_order_number or len(normalized_phone) < 10:
        flash("Order not found. Please check your details.")
        return redirect(url_for("track_order"))

    candidates = (
        Order.query
        .filter(Order.order_number == cleaned_order_number)
        .order_by(Order.created_at.desc(), Order.id.desc())
        .limit(5)
        .all()
    )

    order = next(
        (candidate for candidate in candidates
         if normalize_phone(candidate.customer_phone) == normalized_phone),
        None
    )

    if (
        not order
        or normalize_phone(order.customer_phone) != normalized_phone
    ):
        flash("Order not found. Please check your details.")
        return redirect(url_for("track_order"))

    if order.status not in CUSTOMER_CANCELLABLE_STATUSES:
        flash(
            f"This order is already '{order.status}' and can no "
            "longer be cancelled."
        )
    else:
        try:
            locked_order = lock_row(
                Order.query.filter(Order.id == order.id)
            )
            if not locked_order:
                flash("Order not found. Please try again.")
                return redirect(url_for("track_order", order_id=order_id, phone=phone))
            if locked_order.status not in CUSTOMER_CANCELLABLE_STATUSES:
                flash("This order can no longer be cancelled.")
                return redirect(url_for("track_order", order_id=order_id, phone=phone))
            set_order_status_safely(locked_order, "Cancelled")
            order = locked_order
            db.session.commit()
            flash(f"Order #{order.order_number or order.id} has been cancelled.")
        except Exception as e:
            db.session.rollback()
            safe_log("CANCEL ORDER ERROR:", repr(e))
            flash("Could not cancel the order. Please try again.")

    return redirect(
        url_for("track_order", order_id=order_id, phone=phone)
    )


