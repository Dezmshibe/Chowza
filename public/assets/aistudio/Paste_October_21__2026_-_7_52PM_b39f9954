def get_order_items(order):

    if not order:
        return []

    try:

        items = json.loads(
            order.items
        )

        if not isinstance(
            items,
            list
        ):
            return []

        return items

    except (
        TypeError,
        ValueError,
        json.JSONDecodeError
    ) as e:

        safe_log(
            "GET ORDER ITEMS ERROR:",
            repr(e)
        )

        return []

