# ============================================================
# YOCO WEBHOOK SIGNATURE VERIFICATION
# ============================================================

def verify_yoco_webhook_signature(
    request_body,
    webhook_id,
    webhook_timestamp,
    webhook_signature,
    secret
):
    """
    Verify that a Yoco webhook request was signed
    with the webhook secret issued by Yoco.
    """

    if not request_body:
        return False

    if not webhook_id or not webhook_timestamp:
        return False

    if not webhook_signature or not secret:
        return False

    try:
        timestamp = int(webhook_timestamp)
    except (TypeError, ValueError):
        return False

    current_timestamp = int(time.time())

    if abs(current_timestamp - timestamp) > 180:
        return False

    signed_content = (
        f"{webhook_id}.{webhook_timestamp}.{request_body}"
    )

    secret_value = secret.strip()

    if secret_value.startswith("whsec_"):
        secret_value = secret_value[6:]

    try:
        secret_bytes = base64.b64decode(secret_value)
    except Exception:
        return False

    expected_signature = base64.b64encode(
        hmac.new(
            secret_bytes,
            signed_content.encode("utf-8"),
            hashlib.sha256
        ).digest()
    ).decode("utf-8")

    provided_signatures = webhook_signature.split(" ")

    for signature in provided_signatures:

        if signature.startswith("v1,"):
            signature = signature[3:]

        if hmac.compare_digest(
            signature,
            expected_signature
        ):
            return True

    return False


def _money_decimal(value):
    try:
        return Decimal(str(value)).quantize(Decimal("0.01"))
    except (InvalidOperation, TypeError, ValueError):
        return None


def yoco_payment_matches_order(order, yoco_result):
    """Validate amount/currency when Yoco supplies those fields.

    The checkout status is authoritative for payment state, while this
    additional check prevents a valid Yoco checkout from being attached
    to an order with a different expected amount.
    """
    if not isinstance(yoco_result, dict):
        return False

    expected = _money_decimal(order.total)
    if expected is None:
        return False

    amount_candidates = [
        yoco_result.get("amount"),
        (yoco_result.get("amountDetails") or {}).get("amount") if isinstance(yoco_result.get("amountDetails"), dict) else None,
        (yoco_result.get("metadata") or {}).get("amount") if isinstance(yoco_result.get("metadata"), dict) else None,
    ]

    supplied = None
    for candidate in amount_candidates:
        supplied = _money_decimal(candidate)
        if supplied is not None:
            break

    # If the provider response does not expose an amount in this shape,
    # retain the existing checkout-status verification rather than guessing
    # a provider-specific response format.
    if supplied is None:
        return True

    # Yoco commonly represents amounts in cents. If the supplied value is
    # an integer substantially larger than the order amount, compare cents.
    if supplied == expected:
        return True

    if supplied == (expected * Decimal("100")):
        return True

    return False


def verify_yoco_checkout(order, business):
    """
    Verify the Yoco checkout directly with Yoco's API.

    The business Yoco secret key is used only on the server.
    The browser is never trusted to declare a payment successful.
    """

    if not business.yoco_enabled:
        raise ValueError(
            "Yoco payments are not enabled for this business."
        )

    secret_key = decrypt_sensitive_value(
        business.yoco_secret_key
    ).strip()

    if not secret_key:
        raise ValueError(
            "This business has not configured a Yoco secret key."
        )

    checkout_id = (
        order.payment_reference or ""
    ).strip()

    if not checkout_id:
        raise ValueError(
            "This order does not have a Yoco checkout ID."
        )

    if not re.fullmatch(r"[A-Za-z0-9_-]{1,255}", checkout_id):
        raise ValueError("Invalid Yoco checkout ID.")

    url = (
        "https://payments.yoco.com/api/checkouts/"
        f"{checkout_id}"
    )

    headers = {
        "Authorization": f"Bearer {secret_key}",
        "Content-Type": "application/json"
    }

    response = outbound_request(
        "GET",
        url,
        headers=headers,
        timeout=20
    )

    safe_log(
        "YOCO VERIFY RESPONSE:",
        response.status_code
    )

    if not response.ok:
        safe_log(
            "YOCO VERIFY ERROR:",
            response.status_code,
            level="warning"
        )

        raise RuntimeError(
            "Yoco checkout verification failed."
        )

    result = response.json()

    return result
