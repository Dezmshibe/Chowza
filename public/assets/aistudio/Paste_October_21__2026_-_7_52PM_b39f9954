@limiter.limit("60 per minute")
@app.route("/yoco/webhook", methods=["POST"])
@csrf.exempt
def yoco_webhook():

    request_body = request.get_data(as_text=True)

    webhook_id = request.headers.get("webhook-id", "")
    webhook_timestamp = request.headers.get(
        "webhook-timestamp",
        ""
    )
    webhook_signature = request.headers.get(
        "webhook-signature",
        ""
    )

    if not webhook_id:
        return jsonify({
            "success": False,
            "message": "Missing webhook ID."
        }), 400

    if not webhook_timestamp:
        return jsonify({
            "success": False,
            "message": "Missing webhook timestamp."
        }), 400

    if not webhook_signature:
        return jsonify({
            "success": False,
            "message": "Missing webhook signature."
        }), 400

    try:
        event_data = json.loads(request_body)
    except Exception:
        return jsonify({
            "success": False,
            "message": "Invalid JSON."
        }), 400

    payload = event_data.get("payload") or {}
    metadata = payload.get("metadata") or {}

    checkout_id = str(
        metadata.get("checkoutId", "")
    ).strip()

    if not checkout_id:
        return jsonify({
            "success": False,
            "message": "Missing checkout ID."
        }), 400

    order = lock_row(
        Order.query.filter_by(payment_reference=checkout_id)
    )

    if not order:
        return jsonify({
            "success": False,
            "message": "Order not found."
        }), 404

    business = Business.query.get(
        order.business_id
    )

    if not business:
        return jsonify({
            "success": False,
            "message": "Business not found."
        }), 404

    webhook_secret = decrypt_sensitive_value(
        business.yoco_webhook_secret
    ).strip()

    if not webhook_secret:
        safe_log(
            "YOCO WEBHOOK ERROR: "
            "Business has no webhook secret."
        )

        return jsonify({
            "success": False,
            "message": "Webhook not configured."
        }), 500

    signature_valid = verify_yoco_webhook_signature(
        request_body,
        webhook_id,
        webhook_timestamp,
        webhook_signature,
        webhook_secret
    )

    if not signature_valid:
        safe_log(
            "YOCO WEBHOOK REJECTED: "
            "Invalid signature."
        )

        return jsonify({
            "success": False,
            "message": "Invalid webhook signature."
        }), 401

    # Independently verify the checkout with Yoco before changing the order.
    # This protects against a correctly signed event being associated with
    # an unexpected checkout state/amount.
    try:
        yoco_result = verify_yoco_checkout(order, business)
    except Exception as exc:
        safe_log("YOCO WEBHOOK CHECKOUT VERIFICATION ERROR:", repr(exc))
        return jsonify({
            "success": False,
            "message": "Checkout verification failed."
        }), 502

    if str(yoco_result.get("status", "")).strip().lower() != "completed":
        return jsonify({
            "success": False,
            "message": "Checkout is not completed."
        }), 409

    if not yoco_payment_matches_order(order, yoco_result):
        safe_log("YOCO WEBHOOK REJECTED: amount mismatch", order.id)
        return jsonify({
            "success": False,
            "message": "Payment amount mismatch."
        }), 400

    event_type = str(
        event_data.get("type", "")
    ).strip().lower()

    safe_log(
        "YOCO WEBHOOK EVENT:",
        event_type,
        "CHECKOUT:",
        checkout_id
    )

    existing_event = YocoWebhookEvent.query.filter_by(
        event_id=webhook_id
    ).first()

    if existing_event:
        return jsonify({
            "success": True,
            "message": "Webhook already processed."
        }), 200

    if event_type == "payment.succeeded":

        if order.payment_status != "Paid":
            try:
                set_payment_status_safely(order, "Paid")
            except ValueError as exc:
                return jsonify({"success": False, "message": str(exc)}), 409

        db.session.add(
            YocoWebhookEvent(
                event_id=webhook_id
            )
        )

        try:
            db.session.commit()
        except Exception as exc:
            from sqlalchemy.exc import IntegrityError
            if isinstance(exc, IntegrityError):
                db.session.rollback()
                return jsonify({
                    "success": True,
                    "message": "Webhook already processed."
                }), 200
            db.session.rollback()
            raise

        try:
            notify_business_new_order(
                order,
                business
            )
        except Exception as exc:
            safe_log(
                "YOCO BUSINESS NOTIFICATION ERROR:",
                repr(exc)
            )

    else:

        db.session.add(
            YocoWebhookEvent(
                event_id=webhook_id
            )
        )

        db.session.commit()

    return jsonify({
        "success": True
    }), 200


