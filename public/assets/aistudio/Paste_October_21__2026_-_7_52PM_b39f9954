@login_required
def subscription_cancel():

    business = get_current_business()

    if not business:
        flash(
            "This account is not connected to a business."
        )
        return redirect(
            url_for("dashboard")
        )

    if (
        business.subscription_status == "active"
        and business.subscription_current_period_end
    ):
        token = (
            business.subscription_id
            or ""
        ).strip()

        if (
            business.subscription_provider
            == "payfast"
            and token
        ):
            try:
                payfast_cancel_subscription(
                    token
                )
            except Exception as exc:
                db.session.rollback()

                safe_log(
                    "PAYFAST SUBSCRIPTION "
                    "CANCEL ERROR:",
                    repr(exc)
                )

                flash(
                    "PayFast could not cancel the "
                    "recurring payment. Your "
                    "subscription was not changed."
                )

                return redirect(
                    url_for("subscription")
                )

        # Stop future PayFast charges but retain access
        # through the already-paid billing period.
        cancel_subscription_at_period_end(
            business
        )

        db.session.commit()

        flash(
            "Your subscription will remain active "
            "until the end of the current billing period."
        )

    else:
        cancel_subscription_immediately(
            business
        )

        db.session.commit()

        flash(
            "Your subscription has been cancelled."
        )

    return redirect(
        url_for("subscription")
    )


