# WHATSAPP WEBHOOK
# ============================================================

def extract_whatsapp_event_ids(data, raw_body):
    """Return stable Meta event/message IDs for webhook replay protection."""
    ids = []
    for entry in data.get("entry", []) or []:
        if not isinstance(entry, dict):
            continue
        for change in entry.get("changes", []) or []:
            if not isinstance(change, dict):
                continue
            value = change.get("value") or {}
            for message in value.get("messages", []) or []:
                if isinstance(message, dict) and message.get("id"):
                    ids.append("message:" + str(message["id"]).strip())
            for status in value.get("statuses", []) or []:
                if isinstance(status, dict) and status.get("id"):
                    ids.append("status:" + str(status["id"]).strip())
    if not ids:
        ids.append("body:" + hashlib.sha256(raw_body).hexdigest())
    return list(dict.fromkeys(ids))


def claim_whatsapp_webhook_events(event_ids):
    """Claim webhook IDs atomically; return False if any is already active/processed."""
    from sqlalchemy.exc import IntegrityError
    now = utc_now()
    for event_id in event_ids:
        existing = WhatsAppWebhookEvent.query.filter_by(event_id=event_id).first()
        if existing:
            if existing.processed_at is not None:
                return False
            received = existing.received_at or now
            if (now - received).total_seconds() < 300:
                return False
            db.session.delete(existing)
            db.session.flush()
        db.session.add(WhatsAppWebhookEvent(event_id=event_id, received_at=now))
        try:
            db.session.flush()
        except IntegrityError:
            db.session.rollback()
            return False
    return True


def mark_whatsapp_webhook_events_processed(event_ids):
    now = utc_now()
    WhatsAppWebhookEvent.query.filter(
        WhatsAppWebhookEvent.event_id.in_(event_ids)
    ).update({"processed_at": now}, synchronize_session=False)
    db.session.commit()


@limiter.limit("120 per minute", methods=["POST"])
@app.route("/webhook", methods=["GET", "POST"])
@csrf.exempt
def whatsapp_webhook():

    # ========================================================
    # META WEBHOOK VERIFICATION
    # ========================================================

    if request.method == "GET":
        mode = request.args.get("hub.mode")
        token = request.args.get("hub.verify_token")
        challenge = request.args.get("hub.challenge")

        if (
            mode == "subscribe"
            and token
            and hmac.compare_digest(
                token,
                WHATSAPP_VERIFY_TOKEN
            )
            and challenge
        ):
            return challenge, 200

        return "Verification failed", 403

    # ========================================================
    # META WEBHOOK POST
    # ========================================================

    raw_body = request.get_data()
    signature_header = request.headers.get(
        "X-Hub-Signature-256",
        ""
    )

    if not WHATSAPP_APP_SECRET:
        safe_log(
            "WHATSAPP WEBHOOK ERROR: "
            "WHATSAPP_APP_SECRET is not configured."
        )
        return jsonify({
            "success": False,
            "message": "Webhook configuration error"
        }), 500

    if not signature_header.startswith("sha256="):
        safe_log(
            "WHATSAPP WEBHOOK REJECTED: "
            "Missing X-Hub-Signature-256."
        )
        return jsonify({
            "success": False,
            "message": "Invalid webhook signature"
        }), 403

    # IMPORTANT: Meta uses sha256=<digest>, not sha256:<digest>.
    provided_signature = signature_header[
        len("sha256="):
    ]

    expected_signature = hmac.new(
        WHATSAPP_APP_SECRET.encode("utf-8"),
        raw_body,
        hashlib.sha256
    ).hexdigest()

    if not hmac.compare_digest(
        provided_signature,
        expected_signature
    ):
        safe_log(
            "WHATSAPP WEBHOOK REJECTED: "
            "Invalid signature."
        )
        return jsonify({
            "success": False,
            "message": "Invalid webhook signature"
        }), 403

    # ========================================================
    # PARSE WEBHOOK JSON
    # ========================================================

    try:
        data = json.loads(
            raw_body.decode("utf-8")
        )
    except (
        UnicodeDecodeError,
        json.JSONDecodeError
    ):
        safe_log(
            "WHATSAPP WEBHOOK REJECTED: Invalid JSON."
        )
        return jsonify({
            "success": False,
            "message": "Invalid JSON"
        }), 400

    safe_log("WHATSAPP WEBHOOK EVENT RECEIVED")

    if data.get("object") != "whatsapp_business_account":
        return jsonify({"success": True}), 200

    webhook_event_ids = extract_whatsapp_event_ids(data, raw_body)

    try:
        if not claim_whatsapp_webhook_events(webhook_event_ids):
            return jsonify({"success": True, "message": "Webhook already processed."}), 200
        db.session.commit()
    except Exception:
        db.session.rollback()
        safe_log("WHATSAPP WEBHOOK EVENT CLAIM ERROR")
        return jsonify({"success": False, "message": "Webhook processing unavailable."}), 503

    # ========================================================
    # CONVERSATION SESSION HELPERS
    # ========================================================

    def get_session(customer_phone):
        session = WhatsAppSession.query.filter_by(
            customer_phone=customer_phone
        ).first()

        if not session:
            session = WhatsAppSession(
                customer_phone=customer_phone,
                step="MAIN_MENU",
                business_ids="[]",
                cart="[]"
            )
            db.session.add(session)

        return session

    def save_session(session):
        session.updated_at = utc_now()
        db.session.commit()

    def reset_session(session):
        session.step = "MAIN_MENU"
        session.business_ids = "[]"
        session.selected_business_id = None
        session.selected_food_id = None
        session.cart = "[]"
        session.customer_name = None
        session.customer_address = None
        session.fulfillment_type = None
        session.payment_method = None

    def load_json_list(raw):
        try:
            value = json.loads(raw or "[]")
            return value if isinstance(value, list) else []
        except (TypeError, ValueError):
            return []

    def send_menu_for_business(customer_phone, session, business):
        sync_subscription_state(business)

        if not business.active or not subscription_is_active(business):
            reset_session(session)
            save_session(session)
            send_whatsapp_message(
                customer_phone,
                "Sorry, that business is not currently available.\n\n"
                "Reply 1 to view available businesses."
            )
            return

        if not business.is_open:
            session.step = "CHOOSE_BUSINESS"
            save_session(session)
            send_whatsapp_message(
                customer_phone,
                f"{business.business_name or business.name} is currently closed.\n\n"
                "Reply 1 to view available businesses."
            )
            return

        foods = Food.query.filter_by(
            business_id=business.id,
            available=True
        ).order_by(
            Food.popular.desc(),
            Food.id.asc()
        ).limit(20).all()

        if not foods:
            session.step = "CHOOSE_BUSINESS"
            save_session(session)
            send_whatsapp_message(
                customer_phone,
                f"{business.business_name or business.name} currently has no available menu items.\n\n"
                "Reply 1 to view another business."
            )
            return

        lines = [
            f"{business.business_name or business.name} menu:",
            ""
        ]

        for index, food in enumerate(foods, start=1):
            lines.append(
                f"{index}. {food.name} - R{float(food.price):.2f}"
            )
            if food.description:
                lines.append(
                    f"   {food.description}"
                )

        lines.extend([
            "",
            "Reply with the number of the item you want.",
            "Send 0 to go back to businesses."
        ])

        # Save the menu IDs in the same session. This means a customer's
        # next numeric reply is interpreted against the menu they actually saw.
        session.business_ids = json.dumps([
            food.id for food in foods
        ])
        session.step = "CHOOSE_FOOD"
        session.selected_business_id = business.id
        session.selected_food_id = None
        save_session(session)

        send_whatsapp_message(
            customer_phone,
            "\n".join(lines)
        )

    # ========================================================
    # PROCESS META EVENTS
    # ========================================================

    for entry in data.get("entry", []):
        for change in entry.get("changes", []):
            field = change.get("field")
            value = change.get("value", {})

            safe_log("WHATSAPP WEBHOOK FIELD:", field)

            messages = value.get("messages", [])

            for message in messages:
                safe_log("WHATSAPP MESSAGE RECEIVED")

                if message.get("type") != "text":
                    safe_log(
                        "WHATSAPP MESSAGE IGNORED: not a text message."
                    )
                    continue

                customer_phone = (
                    message.get("from") or ""
                ).strip()

                message_text = (
                    message.get("text", {})
                    .get("body", "")
                    .strip()
                    .lower()
                )

                safe_log("WHATSAPP CUSTOMER:", mask_phone_for_log(customer_phone))
                safe_log("WHATSAPP TEXT:", message_text)

                if not customer_phone:
                    continue

                try:
                    session = get_session(customer_phone)

                    greetings = {
                        "hi",
                        "hello",
                        "hey",
                        "hiya",
                        "hola",
                        "start",
                        "menu"
                    }

                    if message_text in greetings:
                        reset_session(session)
                        save_session(session)

                        reply = (
                            "Hi! Welcome to Chowza.\n\n"
                            "We make ordering from local food businesses simple.\n\n"
                            "What would you like to do?\n\n"
                            "1. View businesses\n"
                            "2. Browse a menu\n"
                            "3. Track my order\n\n"
                            "Reply with 1, 2, or 3."
                        )

                        sent = send_whatsapp_message(
                            customer_phone,
                            reply
                        )

                        safe_log(
                            "CHOWZA REPLY SENT TO:"
                            if sent else
                            "CHOWZA REPLY FAILED TO:",
                            customer_phone
                        )
                        continue

                    if message_text in {"0", "back", "cancel", "restart"}:
                        reset_session(session)
                        save_session(session)
                        send_whatsapp_message(
                            customer_phone,
                            "You're back at the Chowza main menu.\n\n"
                            "1. View businesses\n"
                            "2. Browse a menu\n"
                            "3. Track my order\n\n"
                            "Reply with 1, 2, or 3."
                        )
                        continue

                    # =================================================
                    # MAIN MENU / VIEW BUSINESSES
                    # =================================================

                    if session.step == "MAIN_MENU":
                        if message_text == "1":
                            businesses = Business.query.filter_by(
                                active=True
                            ).order_by(
                                Business.business_name.asc()
                            ).limit(10).all()

                            if not businesses:
                                send_whatsapp_message(
                                    customer_phone,
                                    "Sorry, there are currently no businesses available."
                                )
                                continue

                            lines = [
                                "Here are the available businesses:",
                                ""
                            ]

                            business_ids = []

                            for index, business in enumerate(
                                businesses,
                                start=1
                            ):
                                business_ids.append(business.id)
                                business_name = (
                                    business.business_name
                                    or business.name
                                    or "Business"
                                )
                                lines.append(
                                    f"{index}. {business_name}"
                                )

                            lines.extend([
                                "",
                                "Reply with the number of the business you want."
                            ])

                            session.step = "CHOOSE_BUSINESS"
                            session.business_ids = json.dumps(business_ids)
                            session.selected_business_id = None
                            session.selected_food_id = None
                            save_session(session)

                            send_whatsapp_message(
                                customer_phone,
                                "\n".join(lines)
                            )
                            continue

                        if message_text == "2":
                            send_whatsapp_message(
                                customer_phone,
                                "To browse a menu, first choose a business.\n\n"
                                "Reply 1 to view available businesses."
                            )
                            continue

                        if message_text == "3":
                            send_whatsapp_message(
                                customer_phone,
                                "To track your order, please send your order number.\n\n"
                                "Example:\nCHZ-1001"
                            )
                            continue

                    # =================================================
                    # CART / CHECKOUT
                    # =================================================

                    if message_text == "cart":
                        cart = load_json_list(session.cart)

                        if not cart:
                            send_whatsapp_message(
                                customer_phone,
                                "Your cart is empty. Choose a menu item first."
                            )
                            continue

                        lines = ["Your cart:", ""]
                        total = 0.0

                        for item in cart:
                            item_total = (
                                float(item.get("price", 0))
                                * int(item.get("quantity", 0))
                            )
                            total += item_total
                            lines.append(
                                f"{item.get('quantity', 0)} x {item.get('name', 'Item')} - R{item_total:.2f}"
                            )

                        lines.extend([
                            "",
                            f"Total: R{total:.2f}",
                            "",
                            "Send checkout to continue."
                        ])
                        send_whatsapp_message(customer_phone, "\n".join(lines))
                        continue

                    if message_text == "checkout":
                        cart = load_json_list(session.cart)
                        if not cart or not session.selected_business_id:
                            send_whatsapp_message(
                                customer_phone,
                                "Your cart is empty. Choose a menu item first."
                            )
                            continue

                        session.step = "CHOOSE_FULFILLMENT"
                        save_session(session)
                        send_whatsapp_message(
                            customer_phone,
                            "How would you like to receive your order?\n\n"
                            "1. Delivery\n"
                            "2. Pickup\n\n"
                            "Reply with 1 or 2."
                        )
                        continue


                    # =================================================
                    # CHOOSE BUSINESS
                    # =================================================

                    if session.step == "CHOOSE_BUSINESS":
                        try:
                            selection = int(message_text)
                        except ValueError:
                            selection = 0

                        business_ids = load_json_list(
                            session.business_ids
                        )

                        if selection < 1 or selection > len(business_ids):
                            send_whatsapp_message(
                                customer_phone,
                                "Please reply with a valid business number from the list.\n\n"
                                "Send 0 to return to the main menu."
                            )
                            continue

                        business_id = business_ids[selection - 1]
                        business = db.session.get(
                            Business,
                            int(business_id)
                        )

                        if not business:
                            reset_session(session)
                            save_session(session)
                            send_whatsapp_message(
                                customer_phone,
                                "Sorry, that business could not be found.\n\n"
                                "Reply 1 to view businesses again."
                            )
                            continue

                        session.selected_business_id = business.id
                        save_session(session)
                        send_menu_for_business(
                            customer_phone,
                            session,
                            business
                        )
                        continue

                    # =================================================
                    # CHOOSE FOOD
                    # =================================================

                    if session.step == "CHOOSE_FOOD":
                        if not session.selected_business_id:
                            reset_session(session)
                            save_session(session)
                            send_whatsapp_message(
                                customer_phone,
                                "Please choose a business first.\n\n"
                                "Reply 1 to view businesses."
                            )
                            continue

                        try:
                            selection = int(message_text)
                        except ValueError:
                            selection = 0

                        food_ids = load_json_list(
                            session.business_ids
                        )

                        if selection < 1 or selection > len(food_ids):
                            send_whatsapp_message(
                                customer_phone,
                                "Please reply with a valid menu item number.\n\n"
                                "Send 0 to go back to businesses."
                            )
                            continue

                        food = db.session.get(
                            Food,
                            int(food_ids[selection - 1])
                        )

                        if (
                            not food
                            or food.business_id != session.selected_business_id
                            or not food.available
                        ):
                            send_whatsapp_message(
                                customer_phone,
                                "Sorry, that menu item is no longer available."
                            )
                            continue

                        session.selected_food_id = food.id
                        session.step = "CHOOSE_QUANTITY"
                        save_session(session)

                        send_whatsapp_message(
                            customer_phone,
                            f"{food.name} - R{float(food.price):.2f}\n\n"
                            "How many would you like?\n\n"
                            "Reply with a number, for example 2."
                        )
                        continue

                    # =================================================
                    # CHOOSE QUANTITY
                    # =================================================

                    if session.step == "CHOOSE_QUANTITY":
                        try:
                            quantity = int(message_text)
                        except ValueError:
                            quantity = 0

                        if quantity < 1 or quantity > 50:
                            send_whatsapp_message(
                                customer_phone,
                                "Please enter a quantity between 1 and 50."
                            )
                            continue

                        food = db.session.get(
                            Food,
                            session.selected_food_id
                        ) if session.selected_food_id else None

                        if (
                            not food
                            or food.business_id != session.selected_business_id
                            or not food.available
                        ):
                            reset_session(session)
                            save_session(session)
                            send_whatsapp_message(
                                customer_phone,
                                "Sorry, that item is no longer available.\n\n"
                                "Reply 1 to start again."
                            )
                            continue

                        cart = load_json_list(session.cart)

                        existing = None
                        for item in cart:
                            if item.get("food_id") == food.id:
                                existing = item
                                break

                        if existing:
                            existing["quantity"] = int(
                                existing.get("quantity", 0)
                            ) + quantity
                        else:
                            cart.append({
                                "food_id": food.id,
                                "name": food.name,
                                "price": float(food.price),
                                "quantity": quantity
                            })

                        session.cart = json.dumps(cart)
                        session.step = "CHOOSE_FOOD"
                        session.selected_food_id = None
                        save_session(session)

                        cart_total = sum(
                            float(item.get("price", 0))
                            * int(item.get("quantity", 0))
                            for item in cart
                        )

                        send_whatsapp_message(
                            customer_phone,
                            f"Added {quantity} x {food.name} to your cart.\n\n"
                            f"Cart total: R{cart_total:.2f}\n\n"
                            "Reply with another menu item number to add more, or send *checkout* to continue.\n"
                            "Send *cart* to view your cart."
                        )
                        continue

                    # =================================================
                    # CHECKOUT - FULFILLMENT
                    # =================================================

                    if session.step == "CHOOSE_FULFILLMENT":
                        if message_text == "1":
                            session.fulfillment_type = "Delivery"
                            session.step = "CUSTOMER_NAME"
                            save_session(session)
                            send_whatsapp_message(
                                customer_phone,
                                "Please enter your name."
                            )
                            continue

                        if message_text == "2":
                            session.fulfillment_type = "Pickup"
                            session.customer_address = ""
                            session.step = "CUSTOMER_NAME"
                            save_session(session)
                            send_whatsapp_message(
                                customer_phone,
                                "Please enter your name."
                            )
                            continue

                        send_whatsapp_message(
                            customer_phone,
                            "Please reply with 1 for Delivery or 2 for Pickup."
                        )
                        continue

                    # =================================================
                    # CHECKOUT - CUSTOMER NAME
                    # =================================================

                    if session.step == "CUSTOMER_NAME":
                        if not message_text or len(message_text) > 100:
                            send_whatsapp_message(
                                customer_phone,
                                "Please enter a valid name (maximum 100 characters)."
                            )
                            continue

                        session.customer_name = message.get("text", {}).get("body", "").strip()

                        if session.fulfillment_type == "Delivery":
                            session.step = "CUSTOMER_ADDRESS"
                            save_session(session)
                            send_whatsapp_message(
                                customer_phone,
                                "Please enter your delivery address."
                            )
                        else:
                            session.step = "PAYMENT_METHOD"
                            save_session(session)
                            send_whatsapp_message(
                                customer_phone,
                                "How would you like to pay?\n\n"
                                "1. Cash\n"
                                "2. Yoco\n\n"
                                "Reply with 1 or 2."
                            )
                        continue

                    # =================================================
                    # CHECKOUT - DELIVERY ADDRESS
                    # =================================================

                    if session.step == "CUSTOMER_ADDRESS":
                        address = message.get("text", {}).get("body", "").strip()
                        if not address or len(address) > 300:
                            send_whatsapp_message(
                                customer_phone,
                                "Please enter a valid delivery address (maximum 300 characters)."
                            )
                            continue

                        session.customer_address = address
                        session.step = "PAYMENT_METHOD"
                        save_session(session)
                        send_whatsapp_message(
                            customer_phone,
                            "How would you like to pay?\n\n"
                            "1. Cash\n"
                            "2. Yoco\n\n"
                            "Reply with 1 or 2."
                        )
                        continue

                    # =================================================
                    # CHECKOUT - PAYMENT METHOD
                    # =================================================

                    if session.step == "PAYMENT_METHOD":
                        business = db.session.get(Business, session.selected_business_id)

                        if not business:
                            reset_session(session)
                            save_session(session)
                            send_whatsapp_message(customer_phone, "Business not found. Send Hi to start again.")
                            continue

                        if message_text == "1":
                            session.payment_method = "Cash"
                        elif message_text == "2":
                            if not business.yoco_enabled:
                                send_whatsapp_message(
                                    customer_phone,
                                    "Yoco payments are not available for this business.\n\n"
                                    "Reply 1 for Cash."
                                )
                                continue
                            session.payment_method = "Yoco"
                        else:
                            send_whatsapp_message(
                                customer_phone,
                                "Please reply with 1 for Cash or 2 for Yoco."
                            )
                            continue

                        cart = load_json_list(session.cart)
                        total = sum(
                            float(item.get("price", 0)) * int(item.get("quantity", 0))
                            for item in cart
                        )
                        lines = [
                            "Please confirm your order:",
                            "",
                            f"Business: {business.business_name or business.name}",
                            f"Name: {session.customer_name}",
                            f"Order type: {session.fulfillment_type}",
                        ]
                        if session.fulfillment_type == "Delivery":
                            lines.append(f"Address: {session.customer_address}")
                        lines.extend(["", "Items:"])
                        for item in cart:
                            item_total = float(item.get("price", 0)) * int(item.get("quantity", 0))
                            lines.append(f"{item.get('quantity', 0)} x {item.get('name', 'Item')} - R{item_total:.2f}")
                        lines.extend([
                            "",
                            f"Total: R{total:.2f}",
                            f"Payment: {session.payment_method}",
                            "",
                            "Reply CONFIRM to place the order.",
                            "Reply CANCEL to cancel."
                        ])
                        session.step = "CONFIRM_ORDER"
                        save_session(session)
                        send_whatsapp_message(customer_phone, "\n".join(lines))
                        continue

                    # =================================================
                    # CHECKOUT - CONFIRM AND CREATE ORDER
                    # =================================================

                    if session.step == "CONFIRM_ORDER":
                        if message_text == "cancel":
                            reset_session(session)
                            save_session(session)
                            send_whatsapp_message(
                                customer_phone,
                                "Your order was cancelled. Send Hi to start again."
                            )
                            continue

                        if message_text != "confirm":
                            send_whatsapp_message(
                                customer_phone,
                                "Reply CONFIRM to place the order, or CANCEL to cancel."
                            )
                            continue

                        business = db.session.get(Business, session.selected_business_id)
                        cart = load_json_list(session.cart)

                        if not business or not cart:
                            reset_session(session)
                            save_session(session)
                            send_whatsapp_message(customer_phone, "Your session has expired. Send Hi to start again.")
                            continue

                        clean_items = []
                        calculated_total = 0.0

                        for item in cart:
                            food_id = item.get("food_id")
                            food = db.session.get(Food, food_id) if food_id else None
                            if not food or food.business_id != business.id or not food.available:
                                send_whatsapp_message(
                                    customer_phone,
                                    "One of the items in your cart is no longer available. Send Hi to start again."
                                )
                                reset_session(session)
                                save_session(session)
                                break
                            quantity = max(1, min(int(item.get("quantity", 0)), 50))
                            item_total = round(float(food.price) * quantity, 2)
                            calculated_total += item_total
                            clean_items.append({
                                "id": food.id,
                                "name": food.name,
                                "price": round(float(food.price), 2),
                                "quantity": quantity,
                                "total": item_total
                            })
                        else:
                            calculated_total = round(calculated_total, 2)
                            record_order_attempt()
                            daily_order_number, order_day = generate_daily_order_number(business.id)
                            order = Order(
                                order_number=daily_order_number,
                                order_day=order_day,
                                customer_name=session.customer_name or "WhatsApp Customer",
                                customer_phone=customer_phone,
                                customer_address=session.customer_address or "",
                                items=json.dumps(clean_items),
                                total=calculated_total,
                                status="Pending",
                                business_id=business.id,
                                fulfillment_type=session.fulfillment_type or "Pickup",
                                payment_method=session.payment_method or "Cash"
                            )
                            try:
                                db.session.add(order)
                                db.session.commit()
                            except Exception as exc:
                                db.session.rollback()
                                safe_log("WHATSAPP ORDER SAVE ERROR:", repr(exc))
                                send_whatsapp_message(customer_phone, "Sorry, we could not place your order. Please try again.")
                                continue

                            if order.payment_method == "Yoco":
                                try:
                                    yoco_checkout = create_yoco_checkout(order, business)
                                    order.payment_reference = yoco_checkout["checkout_id"]
                                    order.payment_status = "Awaiting Payment"
                                    db.session.commit()
                                    payment_url = yoco_checkout["redirect_url"]
                                    send_whatsapp_message(
                                        customer_phone,
                                        f"Order {order.order_number} has been created.\n\n"
                                        f"Total: R{calculated_total:.2f}\n\n"
                                        f"Pay securely here:\n{payment_url}\n\n"
                                        "Your order will be sent to the business after payment is confirmed."
                                    )
                                except Exception as exc:
                                    db.session.rollback()
                                    safe_log("WHATSAPP YOCO CHECKOUT ERROR:", repr(exc))
                                    send_whatsapp_message(
                                        customer_phone,
                                        f"Order {order.order_number} was created, but we could not create the Yoco payment link. Please contact the business."
                                    )
                            else:
                                try:
                                    notify_business_new_order(order, business)
                                except Exception as exc:
                                    safe_log("WHATSAPP BUSINESS NOTIFICATION ERROR:", repr(exc))
                                send_whatsapp_message(
                                    customer_phone,
                                    f"Order confirmed!\n\n"
                                    f"Order number: {order.order_number}\n"
                                    f"Business: {business.business_name or business.name}\n"
                                    f"Total: R{calculated_total:.2f}\n"
                                    f"Status: {order.status}\n\n"
                                    "You can send 3 from the main menu to track your order."
                                )

                            reset_session(session)
                            save_session(session)
                        continue

                    # =================================================
                    # DEFAULT RESPONSE
                    # =================================================

                    send_whatsapp_message(
                        customer_phone,
                        "Sorry, I didn't understand that.\n\n"
                        "Send *Hi* to start, or send *0* to return to the main menu."
                    )

                except Exception as exc:
                    db.session.rollback()
                    safe_log(
                        "WHATSAPP CONVERSATION ERROR:",
                        repr(exc)
                    )
                    send_whatsapp_message(
                        customer_phone,
                        "Sorry, something went wrong. Please send *Hi* to start again."
                    )

            statuses = value.get("statuses", [])
            for status in statuses:
                safe_log(
                    "WHATSAPP MESSAGE STATUS:",
                    json.dumps(status, indent=2)
                )

    try:
        mark_whatsapp_webhook_events_processed(webhook_event_ids)
    except Exception:
        db.session.rollback()
        safe_log("WHATSAPP WEBHOOK FINALIZATION ERROR")
        return jsonify({"success": False, "message": "Webhook finalization failed."}), 500

    return jsonify({
        "success": True
    }), 200


# ============================================================
# RESPONSE SECURITY HEADERS + STATIC FILE CACHING
# ============================================================

@app.after_request
def add_security_headers(response):
    """Apply browser-facing security controls consistently to every response."""

    # Prevent MIME sniffing.
    response.headers[
        "X-Content-Type-Options"
    ] = "nosniff"

    # Chowza pages should never be framed by another origin. This also
    # protects business dashboards and customer pages from clickjacking.
    response.headers[
        "X-Frame-Options"
    ] = "DENY"

    # Modern replacement/companion to X-Frame-Options.
    response.headers[
        "Content-Security-Policy"
    ] = "; ".join([
        "default-src 'self'",
        "base-uri 'self'",
        "object-src 'none'",
        "frame-ancestors 'none'",
        "form-action 'self' https://www.payfast.co.za https://sandbox.payfast.co.za",
        "img-src 'self' data: blob: https:",
        "style-src 'self' 'unsafe-inline' https:",
        "script-src 'self' 'unsafe-inline' https:",
        # Inline event-handler attributes such as onclick= and onerror=
        # are a separate XSS vector. Block them even while legacy inline
        # script blocks are still being migrated to external files/nonces.
        "script-src-attr 'none'",
        "font-src 'self' data: https:",
        "connect-src 'self' https:",
        "media-src 'self' https:",
        "worker-src 'self' blob:",
        "manifest-src 'self'",
        "upgrade-insecure-requests" if request.is_secure else "block-all-mixed-content"
    ])

    response.headers[
        "Referrer-Policy"
    ] = "strict-origin-when-cross-origin"

    # Chowza does not need browser access to microphone/camera. Geolocation
    # remains available to the site itself for customer discovery features.
    response.headers[
        "Permissions-Policy"
    ] = (
        "geolocation=(self), microphone=(), camera=(), "
        "payment=(self), usb=(), bluetooth=(), "
        "serial=(), midi=()"
    )

    # Isolate the top-level browsing context from unrelated origins.
    response.headers[
        "Cross-Origin-Opener-Policy"
    ] = "same-origin-allow-popups"

    # Prevent other origins from embedding Chowza resources such as images.
    response.headers[
        "Cross-Origin-Resource-Policy"
    ] = "same-origin"

    # Tell legacy Adobe/Acrobat-style cross-domain clients not to use
    # cross-domain policy files.
    response.headers[
        "X-Permitted-Cross-Domain-Policies"
    ] = "none"

    # HSTS is only safe when the current request is HTTPS. Render terminates
    # TLS at its proxy, so request.is_secure is correct after ProxyFix.
    if request.is_secure and DATABASE_URL:
        response.headers[
            "Strict-Transport-Security"
        ] = "max-age=31536000; includeSubDomains"

    # ========================================================
    # CUSTOMER DATA PRIVACY
    # ========================================================
    # Order pages/APIs contain customer information. Never allow
    # intermediary/browser caching of these responses.
    if (
        request.path == "/track-order"
        or request.path.startswith("/business/") and request.path.endswith("/track-order")
        or request.path.startswith("/order-confirmation/")
        or request.path == "/api/live-order-status"
    ):
        mark_sensitive_response(response)

    # Authenticated/platform pages must not be cached by browsers or proxies.
    if (
        current_user.is_authenticated
        or request.path.startswith("/admin")
        or request.path.startswith("/dashboard")
        or request.path.startswith("/analytics")
        or request.path.startswith("/subscription")
    ):
        response.headers["Cache-Control"] = "no-store, no-cache, must-revalidate, max-age=0"
        response.headers["Pragma"] = "no-cache"
        response.headers["Expires"] = "0"

    # ========================================================
    # STATIC FILE BROWSER CACHING
    # ========================================================
    #
    # Cache CSS, JavaScript, favicon and uploaded images
    # for 7 days.
    #

    if request.path.startswith("/static/"):
        response.headers["Cache-Control"] = (
            "public, max-age=604800"
        )

    # ========================================================
    # ANALYTICS IDENTIFIERS
    # ========================================================
    #
    # Anonymous identifiers used by the first-party
    # analytics system.
    #
    # These do NOT contain:
    # - customer names
    # - phone numbers
    # - addresses
    # - passwords
    # - business login information
    #

    visitor_id = request.cookies.get(
        ANALYTICS_VISITOR_COOKIE
    )

    session_id = request.cookies.get(
        ANALYTICS_SESSION_COOKIE
    )

    if not visitor_id:

        visitor_id = uuid.uuid4().hex

        response.set_cookie(
            ANALYTICS_VISITOR_COOKIE,
            visitor_id,
            max_age=60 * 60 * 24 * 365,
            httponly=True,
            secure=(
                os.environ.get(
                    "WHATSAPP_FOOD_HTTPS",
                    "0"
                ) == "1"
            ),
            samesite="Lax"
        )

    if not session_id:

        session_id = uuid.uuid4().hex

        response.set_cookie(
            ANALYTICS_SESSION_COOKIE,
            session_id,
            max_age=60 * 60 * 24,
            httponly=True,
            secure=(
                os.environ.get(
                    "WHATSAPP_FOOD_HTTPS",
                    "0"
                ) == "1"
            ),
            samesite="Lax"
        )

    return response

