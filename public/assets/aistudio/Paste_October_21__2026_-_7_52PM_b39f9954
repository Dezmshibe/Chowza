# ============================================================
# PAYFAST SUBSCRIPTION HELPERS
# ============================================================
def payfast_signature(data, passphrase=None):
    """Generate PayFast signature and safely print diagnostic data."""

    parts = []
    debug_parts = []

    for key, value in data.items():
        if key == "signature":
            continue

        if value is None or str(value) == "":
            continue

        raw_value = str(value).strip()

        encoded = quote_plus(
            raw_value,
            safe="-_."
        ).replace("~", "%7E")

        parts.append(f"{key}={encoded}")

        # Never print Merchant Key or other secret values.
        if key in ("merchant_key",):
            debug_parts.append(f"{key}=[REDACTED]")
        else:
            debug_parts.append(f"{key}={encoded}")

    parameter_string = "&".join(parts)

    if passphrase is not None and str(passphrase).strip() != "":
        encoded_passphrase = quote_plus(
            str(passphrase).strip(),
            safe="-_."
        ).replace("~", "%7E")

        parameter_string += (
            "&passphrase=" + encoded_passphrase
        )

    signature = hashlib.md5(
        parameter_string.encode("utf-8")
    ).hexdigest()

    # Safe diagnostic output.
    # The actual passphrase is NEVER printed.
    debug_string = "&".join(debug_parts)

    safe_log("\n" + "=" * 70)
    safe_log("PAYFAST SIGNATURE GENERATED")
    safe_log("=" * 70)
    safe_log("SIGNED FIELDS:")
    safe_log(debug_string)
    safe_log("\nGENERATED SIGNATURE:")
    safe_log(signature)
    safe_log("\nPARAMETER COUNT:")
    safe_log(len(parts))
    safe_log("=" * 70 + "\n")

    return signature

def payfast_api_signature(
    headers_data,
    body_data=None
):
    """
    Generate the PayFast Recurring Billing API signature.

    PayFast API authentication uses alphabetically sorted header/body
    variables, followed by the passphrase.
    """

    values = {}

    values.update(
        headers_data or {}
    )

    values.update(
        body_data or {}
    )

    parts = []

    for key in sorted(values):
        value = values[key]

        if value is None or str(value) == "":
            continue

        parts.append(
            f"{key}="
            f"{quote_plus(str(value).strip())}"
        )

    parameter_string = "&".join(parts)

    if PAYFAST_PASSPHRASE:
        parameter_string += (
            "&passphrase="
            + quote_plus(
                PAYFAST_PASSPHRASE.strip()
            )
        )

    return hashlib.md5(
        parameter_string.encode("utf-8")
    ).hexdigest()


def payfast_api_request(
    action,
    token,
    method="GET",
    body=None
):
    """Call the PayFast Recurring Billing API."""

    if (
        not PAYFAST_MERCHANT_ID
        or not PAYFAST_PASSPHRASE
    ):
        raise RuntimeError(
            "PayFast API is not configured. "
            "Set PAYFAST_MERCHANT_ID and "
            "PAYFAST_PASSPHRASE."
        )

    token = str(
        token or ""
    ).strip()

    if not token:
        raise RuntimeError(
            "PayFast subscription token is missing."
        )

    if not re.fullmatch(r"[A-Za-z0-9_-]{1,255}", token):
        raise RuntimeError("Invalid PayFast subscription token.")

    timestamp = datetime.now(
        SOUTH_AFRICA_TZ
    ).isoformat(
        timespec="seconds"
    )

    api_headers = {
        "merchant-id": PAYFAST_MERCHANT_ID,
        "version": PAYFAST_API_VERSION,
        "timestamp": timestamp,
    }

    body = body or {}

    signature = payfast_api_signature(
        api_headers,
        body
    )

    headers = {
        **api_headers,
        "signature": signature,
        "Accept": "application/json",
    }

    url = (
        f"{PAYFAST_API_BASE_URL}"
        f"/subscriptions/{token}/{action}"
    )

    if PAYFAST_MODE == "sandbox":
        url += "?testing=true"

    validate_outbound_url(url)

    response = outbound_request(
        method,
        url,
        headers=headers,
        data=body if body else None,
        timeout=20,
    )

    safe_log(
        "PAYFAST API RESPONSE:",
        response.status_code,
        action
    )

    if not response.ok:
        safe_log(
            "PAYFAST API ERROR:",
            response.status_code,
            level="warning"
        )
        raise RuntimeError(
            "PayFast subscription API request failed."
        )

    try:
        result = response.json()
    except ValueError:
        raise RuntimeError(
            "PayFast returned an invalid API response."
        )

    if (
        str(result.get("status", "")).lower()
        != "success"
    ):
        safe_log(
            "PAYFAST API FAILED RESPONSE:",
            result
        )
        raise RuntimeError(
            "PayFast subscription API rejected the request."
        )

    return result


def payfast_cancel_subscription(
    token
):
    return payfast_api_request(
        "cancel",
        token,
        method="PUT"
    )




def add_one_month(dt):
    """
    Add one calendar month while keeping the date valid.

    Example:
        31 January -> 28/29 February
    """

    if not dt:
        return None

    year = dt.year
    month = dt.month + 1

    if month > 12:
        year += 1
        month = 1

    day = min(
        dt.day,
        calendar.monthrange(
            year,
            month
        )[1]
    )

    return dt.replace(
        year=year,
        month=month,
        day=day
    )


def create_payfast_subscription_form(payment):
    """Build an auto-submitting PayFast monthly subscription checkout."""

    if (
        not PAYFAST_MERCHANT_ID
        or not PAYFAST_MERCHANT_KEY
        or not PAYFAST_PASSPHRASE
    ):
        raise RuntimeError(
            "PayFast subscription payments are not configured yet. "
            "Set PAYFAST_MERCHANT_ID, PAYFAST_MERCHANT_KEY and "
            "PAYFAST_PASSPHRASE."
        )

    amount = f"{float(payment.amount):.2f}"
    base_url = get_public_base_url()

    business = db.session.get(Business, payment.business_id)
    if not business:
        raise RuntimeError("Business not found for subscription payment.")

    owner_email = (getattr(business, "email", None) or "").strip()

    # Older Chowza accounts may have the owner email stored on the
    # login account (User.username) rather than Business.email.
    # PayFast needs an email_address, so use the business email first
    # and fall back to the business owner's login username.
    if not owner_email:
        owner_user = User.query.filter_by(
            business_id=business.id
        ).first()

        if owner_user:
            owner_email = (
                getattr(owner_user, "username", None) or ""
            ).strip()

    if not owner_email or "@" not in owner_email:
        raise RuntimeError(
            "No valid email address is available for the business owner. "
            "Please update the business email or login email before "
            "starting the PayFast subscription."
        )

    owner_name = (
        getattr(business, "owner_name", None)
        or "Chowza Business"
    ).strip()
    name_parts = owner_name.split(maxsplit=1)
    first_name = name_parts[0] if name_parts else "Chowza"
    last_name = name_parts[1] if len(name_parts) > 1 else "Business"

    # Keep the fields in PayFast's documented order. The exact same
    # dictionary is signed and then submitted to PayFast.
    data = {
        "merchant_id": PAYFAST_MERCHANT_ID,
        "merchant_key": PAYFAST_MERCHANT_KEY,
        "return_url": f"{base_url}/subscription/payment/success/{payment.id}",
        "cancel_url": f"{base_url}/subscription/payment/cancelled/{payment.id}",
        "notify_url": f"{base_url}/webhooks/payfast",
        "name_first": first_name,
        "name_last": last_name,
        "email_address": owner_email,
        "m_payment_id": f"chowza-subscription-{payment.id}",
        "amount": amount,
        "item_name": f"Chowza {payment.plan.title()} Subscription",
        "item_description": (
            f"Monthly Chowza {payment.plan.title()} software subscription."
        ),
        # PayFast recurring billing uses credit card payments.
        # Keep this in the documented custom-checkout field order.
        "payment_method": "cc",
        "subscription_type": "1",
        "billing_date": datetime.now(SOUTH_AFRICA_TZ).strftime("%Y-%m-%d"),
        "recurring_amount": amount,
        "frequency": "3",
        "cycles": "0",
    }

    data["signature"] = payfast_signature(
        data,
        PAYFAST_PASSPHRASE
    )

    fields = []
    for key, value in data.items():
        fields.append(
            '<input type="hidden" '
            f'name="{escape(str(key), quote=True)}" '
            f'value="{escape(str(value), quote=True)}">'
        )

    html = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Redirecting to PayFast</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{font-family:Arial,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;background:#f7f7f7;color:#222}
.card{background:#fff;padding:32px;border-radius:14px;box-shadow:0 8px 30px rgba(0,0,0,.08);text-align:center;max-width:420px}
button{border:0;border-radius:8px;padding:12px 18px;font-weight:700;cursor:pointer}
</style>
</head>
<body>
<div class="card">
<h2>Redirecting to PayFast</h2>
<p>Please wait while we securely open the payment page.</p>
<form id="payfast-form" method="post" action="__PAYFAST_ACTION__">
__PAYFAST_FIELDS__
<noscript><button type="submit">Continue to PayFast</button></noscript>
</form>
</div>
<script>document.getElementById('payfast-form').submit();</script>
</body>
</html>"""

    return html.replace(
        "__PAYFAST_ACTION__",
        escape(PAYFAST_PROCESS_URL, quote=True)
    ).replace(
        "__PAYFAST_FIELDS__",
        "\n".join(fields)
    )


