@limiter.limit("60 per minute")
@app.route("/analytics/event", methods=["POST"])
@csrf.exempt
def analytics_event():

    try:

        rate_limited, retry_after = is_analytics_rate_limited()

        if rate_limited:
            response = jsonify({
                "success": False,
                "message": "Too many analytics events. Please try again later."
            })
            response.status_code = 429
            response.headers["Retry-After"] = str(retry_after)
            return response

        record_analytics_attempt()

        data, error_response = json_request_object(MAX_ANALYTICS_BYTES)
        if error_response:
            return error_response

        event_type = clean_text(
            data.get("event_type", ""),
            max_length=32,
            field_name="Event type",
            required=True
        ).lower()

        business_id = data.get("business_id")
        food_id = data.get("food_id")

        allowed_events = {
            "page_view",
            "menu_view",
            "food_view",
            "add_to_cart",
            "cart_opened",
            "checkout_started",
            "order_placed",
            "order_completed"
        }

        allowed_fields = {"event_type", "business_id", "food_id"}
        if set(data) - allowed_fields:
            return jsonify({
                "success": False,
                "message": "Unexpected analytics fields."
            }), 400

        if event_type not in allowed_events:
            return jsonify({
                "success": False,
                "message": "Invalid analytics event."
            }), 400

        if business_id is not None:
            try:
                business_id = int(business_id)
            except (TypeError, ValueError):
                return jsonify({
                    "success": False,
                    "message": "Invalid business identifier."
                }), 400

            if business_id <= 0:
                return jsonify({
                    "success": False,
                    "message": "Invalid business identifier."
                }), 400

            business = db.session.get(Business, business_id)

            if not business:
                return jsonify({
                    "success": False,
                    "message": "Business not found."
                }), 404

            # Do not accept analytics for businesses that are no longer
            # publicly available. This also prevents expired businesses
            # from being kept artificially active in analytics.
            if not business.active or not subscription_is_active(business):
                return jsonify({
                    "success": False,
                    "message": "Business is not available."
                }), 404

        if food_id is not None:
            try:
                food_id = int(food_id)
            except (TypeError, ValueError):
                return jsonify({
                    "success": False,
                    "message": "Invalid food identifier."
                }), 400

            if food_id <= 0:
                return jsonify({
                    "success": False,
                    "message": "Invalid food identifier."
                }), 400

            food = db.session.get(Food, food_id)

            if not food:
                return jsonify({
                    "success": False,
                    "message": "Food item not found."
                }), 404

            # A food item must belong to the same business supplied by
            # the browser. Never allow cross-business analytics.
            if business_id is None or food.business_id != business_id:
                return jsonify({
                    "success": False,
                    "message": "Food item does not belong to this business."
                }), 400

        saved = track_analytics_event(
            event_type,
            business_id=business_id,
            food_id=food_id
        )

        if not saved:
            return jsonify({
                "success": False,
                "message": "Analytics event could not be saved."
            }), 500

        return jsonify({
            "success": True
        }), 200

    except Exception as exc:

        safe_log(
            "ANALYTICS ROUTE ERROR:",
            repr(exc)
        )

        return jsonify({
            "success": False,
            "message": "Analytics request failed."
        }), 500
