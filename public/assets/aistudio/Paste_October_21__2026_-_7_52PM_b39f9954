# ============================================================
# OUTBOUND HTTP / SSRF PROTECTION
# ============================================================
# Chowza only contacts fixed third-party providers. Never allow an attacker
# to turn one of these server-side requests into a request to localhost,
# private RFC1918 space, cloud metadata services, or an arbitrary hostname.

ALLOWED_OUTBOUND_HOSTS = {
    "graph.facebook.com",
    "payments.yoco.com",
    "api.payfast.co.za",
    "sandbox.payfast.co.za",
    "www.payfast.co.za",
}


def validate_outbound_url(url):
    try:
        parsed = urlsplit(str(url))
    except ValueError as exc:
        raise ValueError("Invalid outbound URL.") from exc

    hostname = (parsed.hostname or "").lower().rstrip(".")

    if parsed.scheme != "https" or hostname not in ALLOWED_OUTBOUND_HOSTS:
        raise ValueError("Outbound URL is not allowlisted.")

    if parsed.username or parsed.password:
        raise ValueError("Outbound URL contains credentials.")

    if parsed.fragment:
        raise ValueError("Outbound URL contains a fragment.")

    return True


def outbound_request(method, url, **kwargs):
    validate_outbound_url(url)
    kwargs.setdefault("timeout", 20)
    kwargs.setdefault("allow_redirects", False)
    return requests.request(method, url, **kwargs)

