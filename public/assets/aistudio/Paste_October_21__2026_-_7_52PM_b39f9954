@app.route("/api/dashboard-updates")
@business_owner_required
@login_required
def dashboard_updates():

    # --------------------------------------------------------
    # Make sure the logged-in user belongs to a business
    # --------------------------------------------------------
    if not current_user.business_id:
        return jsonify({
            "success": False,
            "message": "No business connected."
        }), 403

    # --------------------------------------------------------
    # Get the user's business
    # --------------------------------------------------------
    business = db.session.get(
        Business,
        current_user.business_id
    )

    if not business:
        return jsonify({
            "success": False,
            "message": "Business not found."
        }), 404

    # --------------------------------------------------------
    # Get all orders belonging to this business
    # --------------------------------------------------------
    orders = (
        Order.query
        .filter_by(business_id=business.id)
        .filter(
            db.or_(
                Order.payment_method != "Yoco",
                Order.payment_status == "Paid"
            )
        )
        .order_by(Order.id.desc())
        .all()
    )

    # --------------------------------------------------------
    # No orders yet
    # --------------------------------------------------------
    if not orders:
        return jsonify({
            "success": True,
            "latest_order_id": None,
            "latest_order_status": None,
            "order_count": 0,
            "order_state": ""
        }), 200

    # --------------------------------------------------------
    # Latest order
    # --------------------------------------------------------
    latest_order = orders[0]

    # --------------------------------------------------------
    # Build a fingerprint of all orders.
    #
    # Example:
    # 64:Pending|63:Preparing|62:Completed
    #
    # If a new order arrives OR an order status changes,
    # this value changes.
    # --------------------------------------------------------
    order_state = "|".join(
        f"{order.id}:{order.status}"
        for order in orders
    )

    # --------------------------------------------------------
    # Return live dashboard information
    # --------------------------------------------------------
    return jsonify({
        "success": True,
        "latest_order_id": latest_order.id,
        "latest_order_status": latest_order.status,
        "order_count": len(orders),
        "order_state": order_state
    }), 200
