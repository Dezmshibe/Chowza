def ensure_postgres_schema():
    """Add missing SQLAlchemy model columns to an existing PostgreSQL DB."""
    from sqlalchemy import inspect, text

    inspector = inspect(db.engine)
    dialect = db.engine.dialect

    for table_name, table in db.metadata.tables.items():
        if not inspector.has_table(table_name):
            continue

        existing = {c["name"] for c in inspector.get_columns(table_name)}

        for column in table.columns:
            if column.name in existing:
                continue

            type_sql = column.type.compile(dialect=dialect)
            default_sql = ""

            if column.default is not None and not column.default.is_callable:
                value = column.default.arg
                if isinstance(value, bool):
                    default_sql = " DEFAULT TRUE" if value else " DEFAULT FALSE"
                elif isinstance(value, (int, float)):
                    default_sql = f" DEFAULT {value}"
                elif isinstance(value, str):
                    default_sql = " DEFAULT '" + value.replace("'", "''") + "'"

            qtable = dialect.identifier_preparer.quote(table_name)
            qcolumn = dialect.identifier_preparer.quote(column.name)
            sql = f"ALTER TABLE {qtable} ADD COLUMN {qcolumn} {type_sql}{default_sql}"

            try:
                with db.engine.begin() as connection:
                    connection.execute(text(sql))
                safe_log("Added PostgreSQL column:", f"{table_name}.{column.name}")
            except Exception as exc:
                safe_log("POSTGRESQL COLUMN MIGRATION ERROR:", f"{table_name}.{column.name}", repr(exc))

