    re.compile(r"(?i)(api[_-]?key\s*[:=]\s*)[^,\s}]+"),
    re.compile(r"(?i)(yoco[_-]?secret[_-]?key\s*[:=]\s*)[^,\s}]+"),
    re.compile(r"(?i)(chowza[_-]?encryption[_-]?key\s*[:=]\s*)[^,\s}]+"),
]

_PHONE_LOG_RE = re.compile(r"(?<!\d)\+?\d[\d .()\-]{8,}\d(?!\d)")


def _redact_log_text(value):
    """Redact common credential and phone-number patterns before logging."""
    text = str(value)
    for pattern in _SECRET_LOG_PATTERNS:
        text = pattern.sub(r"\1[REDACTED]", text)
    text = _PHONE_LOG_RE.sub("[PHONE REDACTED]", text)
    return text


def safe_log(*parts, level="info"):
    """Log operational diagnostics without exposing credentials or PII."""
    message = " ".join(_redact_log_text(part) for part in parts)
    logger = app.logger
    log_method = getattr(logger, level, logger.info)
    log_method(message)


