# PASS 24: FINAL REQUEST / ENDPOINT GUARD
# ============================================================
SENSITIVE_METHODS = {"POST", "PUT", "PATCH", "DELETE"}


@app.before_request
def final_endpoint_security_guard():
    """Small global guard for malformed security-sensitive requests."""
    if request.method not in SENSITIVE_METHODS:
        return None

    # Never accept credentials or state-changing requests with an obviously
    # malformed Host header in production. PUBLIC_BASE_URL is authoritative.
    if DATABASE_URL:
        expected_host = (urlsplit(PUBLIC_BASE_URL).hostname or "").lower()
        request_host = (request.host.split(":", 1)[0] or "").lower()
        if expected_host and request_host != expected_host:
            return jsonify({"success": False, "message": "Invalid host."}), 400

    return None


