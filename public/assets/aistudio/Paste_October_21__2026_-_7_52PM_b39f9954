    raise RuntimeError("CHOWZA_ENCRYPTION_KEY must be configured in production.")

# Local development gets a persistent key file so encrypted credentials remain
# readable across restarts. Do not commit this file to source control.
if not CHOWZA_ENCRYPTION_KEY:
    try:
        if os.path.exists(CHOWZA_ENCRYPTION_KEY_FILE):
            with open(CHOWZA_ENCRYPTION_KEY_FILE, "r", encoding="utf-8") as key_file:
                CHOWZA_ENCRYPTION_KEY = key_file.read().strip()
        if not CHOWZA_ENCRYPTION_KEY:
            CHOWZA_ENCRYPTION_KEY = Fernet.generate_key().decode("ascii")
            with open(CHOWZA_ENCRYPTION_KEY_FILE, "w", encoding="utf-8") as key_file:
                key_file.write(CHOWZA_ENCRYPTION_KEY)
            try:
                os.chmod(CHOWZA_ENCRYPTION_KEY_FILE, 0o600)
            except OSError:
                pass
    except OSError as exc:
        raise RuntimeError("Could not create/read the local Chowza encryption key.") from exc

try:
    _CHOWZA_FERNET = Fernet(CHOWZA_ENCRYPTION_KEY.encode("ascii"))
except Exception as exc:
    raise RuntimeError("CHOWZA_ENCRYPTION_KEY is invalid. It must be a valid Fernet key.") from exc

SENSITIVE_VALUE_PREFIX = "enc:v1:"


def encrypt_sensitive_value(value):
    """Encrypt a sensitive string before database storage."""
    value = str(value or "").strip()
    if not value:
        return None
    if value.startswith(SENSITIVE_VALUE_PREFIX):
        return value
    token = _CHOWZA_FERNET.encrypt(value.encode("utf-8")).decode("ascii")
    return SENSITIVE_VALUE_PREFIX + token


def decrypt_sensitive_value(value):
    """Decrypt a stored sensitive value; accept legacy plaintext for migration."""
    value = str(value or "").strip()
    if not value:
        return ""
    if not value.startswith(SENSITIVE_VALUE_PREFIX):
        return value
    try:
        return _CHOWZA_FERNET.decrypt(
            value[len(SENSITIVE_VALUE_PREFIX):].encode("ascii")
        ).decode("utf-8")
    except (InvalidToken, UnicodeDecodeError) as exc:
        raise RuntimeError(
            "A stored sensitive credential could not be decrypted. Check CHOWZA_ENCRYPTION_KEY."
        ) from exc


