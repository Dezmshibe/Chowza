def update_order_status(order_id):
    order = get_owned_order_or_404(order_id)

    if current_user.business_id != order.business_id:
        flash("You cannot update this order.")
        return redirect(url_for("dashboard"))

    status = request.form.get("status", "").strip()


    if status not in ALLOWED_ORDER_STATUSES:
        flash("Invalid order status.")
        return redirect(url_for("dashboard"))

    # Read every submitted prep-time value and use the first non-empty value.
    prep_values = request.form.getlist("estimated_prep_minutes")
    prep_raw = ""
    for value in prep_values:
        if value is not None and str(value).strip():
            prep_raw = str(value).strip()
            break

    estimated_prep_minutes = None

    if prep_raw:
        try:
            estimated_prep_minutes = int(prep_raw)
        except (TypeError, ValueError):
            flash("Estimated preparation time must be a valid number of minutes.")
            return redirect(url_for("dashboard"))

        if estimated_prep_minutes < 1 or estimated_prep_minutes > 1440:
            flash("Estimated preparation time must be between 1 and 1440 minutes.")
            return redirect(url_for("dashboard"))

    try:
        locked_order = lock_row(Order.query.filter(Order.id == order.id))
        if not locked_order:
            flash("That order no longer exists.")
            return redirect(url_for("dashboard"))
        if locked_order.business_id != current_user.business_id:
            flash("You cannot update this order.")
            return redirect(url_for("dashboard"))
        set_order_status_safely(locked_order, status)
        order = locked_order
    except ValueError:
        flash("That order status change could not be applied.")
        return redirect(url_for("dashboard"))

    # Only replace the stored estimate when a value was actually supplied.
    # This prevents unrelated status changes from accidentally clearing it.
    if estimated_prep_minutes is not None:
        order.estimated_prep_minutes = estimated_prep_minutes

    try:
        db.session.commit()

    except Exception as e:
        db.session.rollback()
        safe_log("ORDER STATUS ERROR:", repr(e))
        flash("Could not update order status.")
        return redirect(url_for("dashboard"))

    try:
        business = db.session.get(Business, order.business_id)
        if business:
            notify_customer_order_status(order, business)
    except Exception as e:
        safe_log("WHATSAPP CUSTOMER STATUS NOTIFICATION ERROR:", repr(e))

    flash(f"Order #{order.order_number or order.id} updated to {status}.")
    return redirect(url_for("dashboard"))


