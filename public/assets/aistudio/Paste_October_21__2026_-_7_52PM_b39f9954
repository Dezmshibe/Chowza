@app.before_request
def account_ownership_integrity_check():
    """Fail closed if an authenticated business user becomes orphaned.

    The browser never gets to choose the business relationship; the User row
    is the authoritative tenant binding.
    """
    if not current_user.is_authenticated:
        return None

    if getattr(current_user, "is_admin", False):
        return None

    business_id = getattr(current_user, "business_id", None)
    if not business_id:
        logout_user()
        session.clear()
        return redirect(url_for("business_login"))

    business = db.session.get(Business, business_id)
    if not business:
        logout_user()
        session.clear()
        return redirect(url_for("business_login"))

    if getattr(business, "suspended", False):
        logout_user()
        session.clear()
        return redirect(url_for("business_login"))

    return None


