    if business_id:
        business = db.session.get(
            Business,
            business_id
        )

        if business:
            sync_subscription_state(
                business
            )

    return None


def activate_subscription(
    business,
    *,
    provider="manual",
    subscription_id=None,
    customer_id=None,
    payment_id=None,
    period_start=None,
    period_end=None
):
    """Activate a subscription after trusted provider confirmation."""

    # Multiple provider callbacks can target the same business. Lock the
    # business row so period/status fields cannot be overwritten by stale data.
    if getattr(business, "id", None):
        locked_business = lock_business_for_update(business.id)
        if locked_business is None:
            raise ValueError("Business no longer exists.")
        business = locked_business

    now = utc_now()

    start = (
        period_start
        or now
    )

    end = (
        period_end
        or (now + timedelta(days=30))
    )

    business.subscription_status = "active"
    business.active = True
    business.subscription_provider = provider
    business.subscription_started_at = (
        business.subscription_started_at
        or now
    )
    business.subscription_current_period_start = start
    business.subscription_current_period_end = end
    business.subscription_next_payment_at = end
    business.subscription_last_payment_at = now
    business.subscription_payment_status = "paid"
    business.subscription_cancel_at_period_end = False
    business.subscription_cancelled_at = None

    if subscription_id:
        business.subscription_id = str(
            subscription_id
        )

    if customer_id:
        business.subscription_customer_id = str(
            customer_id
        )

    if payment_id:
        existing = SubscriptionPayment.query.filter_by(
            provider_payment_id=str(
                payment_id
            )
        ).first()

        if not existing:
            payment = SubscriptionPayment(
                business_id=business.id,
                plan=(
                    business.plan
                    or DEFAULT_PLAN
                ),
                amount=PLANS.get(
                    (
                        business.plan
                        or DEFAULT_PLAN
                    ),
                    PLANS[DEFAULT_PLAN]
                )["price"],
                currency="ZAR",
                provider=provider,
                provider_payment_id=str(
                    payment_id
                ),
                status="paid",
                billing_period_start=start,
                billing_period_end=end,
                paid_at=now,
            )

            db.session.add(payment)


def cancel_subscription_at_period_end(
    business
):
    """
    Keep Chowza access until the already-paid period ends.
    The payment provider is cancelled separately.
    """

    business.subscription_cancel_at_period_end = True
    business.subscription_payment_status = (
        "cancel_at_period_end"
    )

    if business.subscription_current_period_end:
        business.subscription_next_payment_at = None


def cancel_subscription_immediately(
    business
):
    if getattr(business, "id", None):
        locked_business = lock_business_for_update(business.id)
        if locked_business is not None:
            business = locked_business
    business.subscription_status = "cancelled"
    business.subscription_payment_status = "cancelled"
    business.subscription_cancelled_at = utc_now()
    business.subscription_next_payment_at = None
    business.subscription_cancel_at_period_end = False


def process_subscription_expiry(
    business
):
    """
    Update trial/paid-period state before displaying subscription data.
    Businesses remain active for the configured payment grace period,
    then become expired if payment has not been received.
    """

    if not business:
        return False

    now = utc_now()

    status = (
        business.subscription_status
        or "trialing"
    ).strip().lower()

    changed = False

    # --------------------------------------------------------
    # TRIAL EXPIRY
    # --------------------------------------------------------
    if (
        status == "trialing"
        and business.trial_ends_at
    ):
        trial_end = business.trial_ends_at

        if trial_end.tzinfo is None:
            trial_end = trial_end.replace(
                tzinfo=timezone.utc
            )

        if now >= trial_end:
            business.subscription_status = "past_due"
            business.subscription_payment_status = (
                "payment_required"
            )
            business.active = True
            changed = True

    # --------------------------------------------------------
    # PAID PERIOD EXPIRY
    # --------------------------------------------------------
    elif (
        status == "active"
        and business.subscription_current_period_end
    ):
        period_end = (
            business.subscription_current_period_end
        )

        if period_end.tzinfo is None:
            period_end = period_end.replace(
                tzinfo=timezone.utc
            )

        if now >= period_end:
            if business.subscription_cancel_at_period_end:
                cancel_subscription_immediately(
                    business
                )
                changed = True
            else:
                # Never silently renew. PayFast must send a trusted
                # successful recurring-payment notification first.
                business.subscription_status = "past_due"
                business.subscription_payment_status = (
                    "payment_required"
                )
                business.active = True
                business.subscription_next_payment_at = None
                changed = True

    # --------------------------------------------------------
    # PAYMENT GRACE PERIOD
    # --------------------------------------------------------
    elif status == "past_due":

        if not business.subscription_current_period_end:
            business.subscription_status = "expired"
            business.subscription_payment_status = (
                "payment_required"
            )
            business.active = False
            changed = True
        else:
            period_end = (
                business.subscription_current_period_end
            )

            if period_end.tzinfo is None:
                period_end = period_end.replace(
                    tzinfo=timezone.utc
                )

            grace_end = (
                period_end
                + timedelta(
                    days=SUBSCRIPTION_GRACE_DAYS
                )
            )

            if now <= grace_end:

                # Keep Chowza active during grace.
                business.active = True

                business.subscription_payment_status = (
                    "payment_required"
                )

                changed = True

            else:

                # Grace period has ended.
                business.subscription_status = "expired"
                business.subscription_payment_status = (
                    "payment_required"
                )
                business.active = False
                changed = True

    if changed:
        db.session.commit()

    return changed


