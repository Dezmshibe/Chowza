@app.route("/business/qr-code")
@business_owner_required
@login_required
@requires_feature("qr_code")
def business_qr_code():

    # Get the business belonging to the logged-in user.
    business = None

    if current_user.business_id:

        business = db.session.get(
            Business,
            current_user.business_id
        )

    if not business:

        flash(
            "No business is linked to your account."
        )

        return redirect(
            url_for("dashboard")
        )

    if not business.slug:

        flash(
            "Your business does not have a customer ordering link yet."
        )

        return redirect(
            url_for("dashboard")
        )

    # ========================================================
    # CREATE CUSTOMER ORDERING URL
    # ========================================================

    # PUBLIC_BASE_URL should be set on Render (for example, the public
    # Chowza domain). During local development, use the current request URL.
    base_url = (
        PUBLIC_BASE_URL
        or request.url_root.rstrip("/")
    )

    customer_url = (
        f"{base_url}/business/{business.slug}"
    )

    # ========================================================
    # GENERATE QR CODE
    # ========================================================

    qr = qrcode.QRCode(
        version=1,
        box_size=10,
        border=4
    )

    qr.add_data(
        customer_url
    )

    qr.make(
        fit=True
    )

    qr_image = qr.make_image(

        fill_color="black",

        back_color="white"
    )

    # --------------------------------------------------------
    # CONVERT QR IMAGE TO BASE64
    # --------------------------------------------------------

    buffer = io.BytesIO()

    qr_image.save(
        buffer,
        format="PNG"
    )

    buffer.seek(0)

    qr_base64 = base64.b64encode(
        buffer.getvalue()
    ).decode("utf-8")

    # --------------------------------------------------------
    # DISPLAY QR PAGE
    # --------------------------------------------------------

    return render_template(

        "business_qr_code.html",

        business=business,

        customer_url=customer_url,

        qr_base64=qr_base64
    )
