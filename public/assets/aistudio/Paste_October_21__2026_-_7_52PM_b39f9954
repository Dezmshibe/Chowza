ALLOWED_IMAGE_EXTENSIONS = {
    "png",
    "jpg",
    "jpeg",
    "gif",
    "webp"
}


def allowed_image_file(filename):

    return (
        "."
        in filename
        and
        filename.rsplit(
            ".",
            1
        )[1].lower()
        in ALLOWED_IMAGE_EXTENSIONS
    )


def _image_signature_matches(
    file_storage,
    extension
):

    """Basic signature check to avoid accepting arbitrary files renamed
    with an image extension."""

    try:

        header = (
            file_storage.stream.read(16)
        )

        file_storage.stream.seek(0)

    except Exception:

        return False


    signatures = {

        "jpg":
            header.startswith(
                b"\xff\xd8\xff"
            ),

        "jpeg":
            header.startswith(
                b"\xff\xd8\xff"
            ),

        "png":
            header.startswith(
                b"\x89PNG\r\n\x1a\n"
            ),

        "gif":
            header.startswith(
                (
                    b"GIF87a",
                    b"GIF89a"
                )
            ),

        "webp":
            (
                len(header) >= 12
                and
                header[:4] == b"RIFF"
                and
                header[8:12] == b"WEBP"
            ),
    }


    return bool(
        signatures.get(
            extension,
            False
        )
    )


def save_uploaded_image(file_storage):
    """Validate, safely decode, resize and store an uploaded menu image."""
    if not file_storage or not file_storage.filename:
        return None

    original_name = secure_filename(file_storage.filename)
    if not original_name or not allowed_image_file(original_name):
        return None

    if "." not in original_name:
        return None

    extension = original_name.rsplit(".", 1)[1].lower()

    # Extension alone is never trusted. Require a matching file signature.
    if not _image_signature_matches(file_storage, extension):
        return None

    try:
        file_storage.stream.seek(0)
        image = Image.open(file_storage.stream)

        # Force Pillow to inspect the actual image structure before loading
        # pixel data. This catches malformed files and decompression bombs.
        image.verify()

        # verify() consumes the decoder, so reopen the stream for decoding.
        file_storage.stream.seek(0)
        image = Image.open(file_storage.stream)

        if image.width <= 0 or image.height <= 0:
            return None

        if image.width * image.height > 25_000_000:
            return None

        image.load()
        image = ImageOps.exif_transpose(image)

        # Flatten transparency onto a white background.
        if image.mode in ("RGBA", "LA"):
            background = Image.new("RGB", image.size, "white")
            background.paste(image, mask=image.getchannel("A"))
            image = background
        elif image.mode == "P":
            image = image.convert("RGBA")
            background = Image.new("RGB", image.size, "white")
            background.paste(image, mask=image.getchannel("A"))
            image = background
        else:
            image = image.convert("RGB")

        image.thumbnail((1200, 1200), Image.Resampling.LANCZOS)

        # Never use the user supplied filename on disk.
        filename = f"{uuid.uuid4().hex}.jpg"
        upload_root = os.path.abspath(app.config["UPLOAD_FOLDER"])
        output_path = os.path.abspath(os.path.join(upload_root, filename))

        if os.path.commonpath([upload_root, output_path]) != upload_root:
            return None

        image.save(
            output_path,
            format="JPEG",
            quality=82,
            optimize=True,
            progressive=True
        )

        return filename

    except (UnidentifiedImageError, Image.DecompressionBombError,
            Image.DecompressionBombWarning, OSError, ValueError):
        return None
    except Exception as exc:
        safe_log("IMAGE PROCESSING ERROR:", repr(exc))
        return None


def delete_image_file(filename):
    """Delete only a server-generated image inside the upload directory."""
    if not filename or os.path.basename(filename) != filename:
        return

    # Current Chowza uploads are UUID.jpg. Keep compatibility with older
    # UUID-named image files while rejecting arbitrary paths.
    if not re.fullmatch(r"[0-9a-fA-F]{32}\.(?:jpg|jpeg|png|gif|webp)", filename):
        return

    upload_root = os.path.abspath(app.config["UPLOAD_FOLDER"])
    path = os.path.abspath(os.path.join(upload_root, filename))

    if os.path.commonpath([upload_root, path]) != upload_root:
        return

    try:
        if os.path.isfile(path):
            os.remove(path)
    except OSError as exc:
        safe_log("IMAGE DELETE ERROR:", repr(exc))


