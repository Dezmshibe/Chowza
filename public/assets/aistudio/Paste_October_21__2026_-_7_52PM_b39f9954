def create_yoco_checkout(order, business):
    """
    Create a Yoco hosted checkout for a specific business.

    The business Yoco secret key is used ONLY on the server.
    It is never sent to the customer's browser.
    """

    if not business.yoco_enabled:
        raise ValueError(
            "Yoco payments are not enabled for this business."
        )

    secret_key = decrypt_sensitive_value(
        business.yoco_secret_key
    ).strip()

    if not secret_key:
        raise ValueError(
            "This business has not configured a Yoco secret key."
        )

    amount_in_cents = int(
        round(float(order.total) * 100)
    )

    if amount_in_cents <= 0:
        raise ValueError(
            "Order amount must be greater than zero."
        )

    url = "https://payments.yoco.com/api/checkouts"

    payload = {
        "amount": amount_in_cents,
        "currency": "ZAR",

        "successUrl": (
            get_public_base_url()
            + f"/yoco/payment/success/{order.id}"
        ),

        "cancelUrl": (
            get_public_base_url()
            + f"/yoco/payment/cancelled/{order.id}"
        ),

        "failureUrl": (
            get_public_base_url()
            + f"/yoco/payment/failed/{order.id}"
        ),

        "externalId": str(order.id),

        "metadata": {
            "orderId": str(order.id),
            "businessId": str(business.id)
        }
    }
    headers = {
        "Authorization": f"Bearer {secret_key}",
        "Content-Type": "application/json",
        "Idempotency-Key": f"whatsappfood-order-{order.id}"
    }

    response = outbound_request(
        "POST",
        url,
        json=payload,
        headers=headers,
        timeout=20
    )

    safe_log(
        "YOCO CHECKOUT RESPONSE:",
        response.status_code
    )

    if not response.ok:
        safe_log(
            "YOCO CHECKOUT ERROR:",
            response.status_code,
            level="warning"
        )

        raise RuntimeError(
            "Yoco checkout creation failed."
        )

    result = response.json()

    checkout_id = result.get("id")
    redirect_url = result.get("redirectUrl")

    if not checkout_id or not redirect_url:
        safe_log(
            "YOCO INVALID RESPONSE:",
            result
        )

        raise RuntimeError(
            "Yoco returned an invalid checkout response."
        )

    return {
        "checkout_id": checkout_id,
        "redirect_url": redirect_url
    }
