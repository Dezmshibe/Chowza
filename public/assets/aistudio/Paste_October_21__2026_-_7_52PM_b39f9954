def admin_required(view_function):
    """Require an authenticated Chowza platform administrator."""

    @wraps(view_function)
    @login_required
    def wrapped(*args, **kwargs):
        if not getattr(current_user, "is_admin", False):
            flash("Administrator access is required.")
            return redirect(url_for("dashboard"))
        return view_function(*args, **kwargs)

    return wrapped

def business_owner_required(view_function):
    """Require an authenticated user linked to their own business.

    This is the central ownership gate for all business-owner routes.
    It deliberately does not grant access based on a business_id supplied
    by the browser; the only trusted business_id is current_user.business_id.
    """
    @wraps(view_function)
    @login_required
    def wrapped(*args, **kwargs):
        business_id = getattr(current_user, "business_id", None)

        if not business_id:
            flash("This account is not connected to a business.")
            return redirect(url_for("dashboard"))

        business = db.session.get(Business, business_id)

        if not business:
            flash("The business linked to this account could not be found.")
            return redirect(url_for("dashboard"))

        if getattr(business, "suspended", False):
            flash("This business account has been suspended.")
            return redirect(url_for("business_login"))

        # Do not allow a disabled business to keep using owner-only
        # management endpoints. Public ordering is separately controlled
        # by the business active/open and subscription checks.
        if not getattr(business, "active", True):
            flash("This business account is currently inactive.")
            return redirect(url_for("business_login"))

        # Make the trusted owner business available to the view without
        # trusting a business_id from request.args/request.form/request.json.
        g.business = business
        return view_function(*args, **kwargs)

    return wrapped


