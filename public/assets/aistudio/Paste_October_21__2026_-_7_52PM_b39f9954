from zoneinfo import ZoneInfo

SOUTH_AFRICA_TZ = ZoneInfo("Africa/Johannesburg")


def utc_now():
    """
    Return the current time as a timezone-aware UTC datetime.
    Use this for database timestamps and security/rate-limit logic.
    """
    return datetime.now(timezone.utc)


def south_africa_now():
    """
    Return the current date/time in South African time (UTC+2).
    """
    return datetime.now(SOUTH_AFRICA_TZ)


def to_south_africa(dt):
    """
    Convert a datetime to South African time.

    Handles both:
    - timezone-aware UTC datetimes
    - older naive UTC datetimes already stored in SQLite
    """
    if not dt:
        return None

    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)

    return dt.astimezone(SOUTH_AFRICA_TZ)
