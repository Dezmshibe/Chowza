BILLING_WEBHOOK_SECRET = os.environ.get(
    "CHOWZA_BILLING_WEBHOOK_SECRET",
    ""
).strip()


def verify_billing_webhook(
    raw_body,
    signature
):
    if (
        not BILLING_WEBHOOK_SECRET
        or not signature
    ):
        return False

    expected = hmac.new(
        BILLING_WEBHOOK_SECRET.encode(
            "utf-8"
        ),
        raw_body,
        hashlib.sha256
    ).hexdigest()

    supplied = signature.strip()

    if supplied.startswith(
        "sha256="
    ):
        supplied = supplied[7:]

    return hmac.compare_digest(
        expected,
        supplied
    )


def claim_billing_webhook_event(event_id):
    if not event_id:
        return True
    existing = BillingWebhookEvent.query.filter_by(event_id=event_id).first()
    if existing and existing.processed_at is not None:
        return False
    if existing:
        return False
    db.session.add(BillingWebhookEvent(event_id=event_id, received_at=utc_now()))
    db.session.flush()
    return True


@limiter.limit("30 per minute")
@app.route(
    "/webhooks/billing",
    methods=["POST"]
)
@csrf.exempt
def billing_webhook():

    raw_body = request.get_data()

    signature = request.headers.get(
        "X-Chowza-Signature",
        ""
    )

    if not verify_billing_webhook(
        raw_body,
        signature
    ):
        return jsonify(
            {
                "error":
                    "invalid signature"
            }
        ), 401

    try:
        payload = request.get_json(
            silent=False
        ) or {}

    except Exception:
        return jsonify(
            {
                "error":
                    "invalid JSON"
            }
        ), 400

    event_id = str(payload.get("id") or payload.get("event_id") or "").strip()
    if not event_id:
        event_id = hashlib.sha256(raw_body).hexdigest()

    try:
        if not claim_billing_webhook_event(event_id):
            db.session.rollback()
            return jsonify({"received": True, "handled": True}), 200
    except Exception:
        db.session.rollback()
        safe_log("BILLING WEBHOOK EVENT CLAIM ERROR")
        return jsonify({"error": "webhook processing unavailable"}), 503

    event_type = str(payload.get("type", "")).strip().lower()


    data = (
        payload.get("data")
        or {}
    )

    business_id = data.get(
        "business_id"
    )

    if not business_id:
        return jsonify(
            {
                "error":
                    "business_id is required"
            }
        ), 400

    try:
        business = db.session.get(
            Business,
            int(business_id)
        )
    except (
        TypeError,
        ValueError
    ):
        return jsonify(
            {
                "error":
                    "invalid business_id"
            }
        ), 400

    if not business:
        return jsonify(
            {
                "error":
                    "business not found"
            }
        ), 404

    try:

        if event_type in {
            "subscription.active",
            "payment.succeeded",
            "invoice.paid"
        }:

            period_start = data.get(
                "period_start"
            )

            period_end = data.get(
                "period_end"
            )

            def parse_dt(value):
                if not value:
                    return None

                if isinstance(
                    value,
                    (int, float)
                ):
                    return datetime.fromtimestamp(
                        value,
                        tz=timezone.utc
                    )

                return datetime.fromisoformat(
                    str(value).replace(
                        "Z",
                        "+00:00"
                    )
                )

            activate_subscription(
                business,
                provider=str(
                    data.get(
                        "provider"
                    )
                    or "unknown"
                ),
                subscription_id=data.get(
                    "subscription_id"
                ),
                customer_id=data.get(
                    "customer_id"
                ),
                payment_id=data.get(
                    "payment_id"
                ),
                period_start=parse_dt(
                    period_start
                ),
                period_end=parse_dt(
                    period_end
                ),
            )

        elif event_type in {
            "payment.failed",
            "invoice.payment_failed",
            "subscription.past_due"
        }:

            business.subscription_status = (
                "past_due"
            )

            business.subscription_payment_status = (
                "failed"
            )

        elif event_type in {
            "subscription.cancelled",
            "subscription.canceled"
        }:

            cancel_subscription_immediately(
                business
            )

        else:
            return jsonify(
                {
                    "received": True,
                    "handled": False
                }
            ), 200

        db.session.commit()

    except Exception:
        db.session.rollback()

        app.logger.exception(
            "BILLING WEBHOOK ERROR"
        )

        return jsonify(
            {
                "error":
                    "webhook processing failed"
            }
        ), 500

    BillingWebhookEvent.query.filter_by(event_id=event_id).update(
        {"processed_at": utc_now()},
        synchronize_session=False
    )
    db.session.commit()

    return jsonify(
        {
            "received": True,
            "handled": True
        }
    ), 200


