@limiter.limit("30 per minute")
@app.route(
    "/business/<slug>/track-order",
    methods=["GET", "POST"]
)
def business_track_order(slug):

    business = Business.query.filter_by(
        slug=slug,
        active=True
    ).first_or_404()

    order = None
    items = []
    error = None

    if request.method == "POST":

        order_number = request.form.get(
            "order_number",
            ""
        ).strip()

        phone = request.form.get(
            "phone",
            ""
        ).strip()

        if not order_number:

            error = (
                "Please enter your order number."
            )

        elif not phone:

            error = (
                "Please enter your phone number."
            )

        else:

            try:

                normalized_phone = normalize_phone(phone)
                cleaned_order_number = valid_order_number(order_number)
                if not cleaned_order_number:
                    raise ValueError("invalid order number")

                candidates = (
                    Order.query
                    .filter(
                        Order.business_id == business.id,
                        Order.order_number == cleaned_order_number
                    )
                    .order_by(Order.created_at.desc(), Order.id.desc())
                    .limit(5)
                    .all()
                )

                order = next(
                    (candidate for candidate in candidates
                     if normalize_phone(candidate.customer_phone) == normalized_phone),
                    None
                )

                if not order:

                    error = (
                        "Order not found. "
                        "Please check your details."
                    )

                elif (
                    normalize_phone(
                        order.customer_phone
                    )
                    != normalized_phone
                ):

                    order = None

                    error = (
                        "Order not found. "
                        "Please check your details."
                    )

                else:

                    items = get_order_items(
                        order
                    )

            except (
                TypeError,
                ValueError
            ):

                error = (
                    "Please enter a valid order number."
                )

    response = make_response(render_template(
        "track_order.html",
        business=business,
        order=order,
        items=items,
        error=error,
        cancellable_statuses=(
            CUSTOMER_CANCELLABLE_STATUSES
        )
    ))
    return mark_sensitive_response(response)

