MAX_ORDER_TOTAL = 10000.00
MAX_CLIENT_REQUEST_ID_LENGTH = 80

def get_client_request_id(data):
    """Return a validated checkout idempotency token, if supplied."""
    raw = request.headers.get("Idempotency-Key", "") or data.get("client_request_id", "")
    value = str(raw or "").strip()
    if not value:
        return None
    if len(value) > MAX_CLIENT_REQUEST_ID_LENGTH:
        raise ValueError("Idempotency key is too long.")
    if not re.fullmatch(r"[A-Za-z0-9._:-]{8,80}", value):
        raise ValueError("Invalid idempotency key.")
    return value

def existing_idempotent_order(business_id, client_request_id):
    if not client_request_id:
        return None
    return Order.query.filter_by(
        business_id=business_id,
        client_request_id=client_request_id
    ).first()

@limiter.limit("10 per minute")
@app.route("/place-order", methods=["POST"])
@csrf.exempt
def place_order():

    rate_limited, retry_after_seconds = (
        is_order_rate_limited()
    )

    if rate_limited:

        retry_after_minutes = max(
            1,
            (retry_after_seconds + 59) // 60
        )

        return jsonify({
            "success": False,
            "message": (
                "Too many order attempts. "
                f"Please wait approximately "
                f"{retry_after_minutes} minute(s) before trying again."
            )
        }), 429

    data, error_response = json_request_object(MAX_JSON_BYTES)
    if error_response:
        return error_response

    try:
        client_request_id = get_client_request_id(data)
    except ValueError:
        return jsonify({
            "success": False,
            "message": "Invalid checkout request identifier."
        }), 400

    business_id = data.get(
        "business_id"
    )

    try:

        business_id = int(
            business_id
        )

    except (
        TypeError,
        ValueError
    ):

        return jsonify({
            "success": False,
            "message": "Invalid business."
        }), 400

    business = Business.query.filter_by(
        id=business_id,
        active=True
    ).first()

    if not business:

        return jsonify({
            "success": False,
            "message": "Business not found or is unavailable."
        }), 404

    existing_order = existing_idempotent_order(
        business.id,
        client_request_id
    )
    if existing_order:
        return jsonify({
            "success": True,
            "duplicate": True,
            "order_id": existing_order.id,
            "order_number": existing_order.order_number,
            "total": round(float(existing_order.total), 2),
            "status": existing_order.status,
            "payment_method": existing_order.payment_method,
            "payment_status": existing_order.payment_status,
            "payment_url": None
        }), 200

    sync_subscription_state(business)

    if not business.active or not subscription_is_active(business):
        return jsonify({
            "success": False,
            "message": "This business is currently unavailable."
        }), 404

    if not business.is_open:
        return jsonify({
            "success": False,
            "message": "This business is currently closed and is not accepting orders."
        }), 403

    try:
        customer_name = clean_text(
            data.get("customer_name", data.get("customerName", "")),
            max_length=MAX_CUSTOMER_NAME_LENGTH,
            field_name="Customer name",
            required=True
        )
    except ValueError:
        return jsonify({
            "success": False,
            "message": "Please enter a valid customer name (maximum 100 characters)."
        }), 400

    customer_phone = normalize_phone(
        data.get(
            "customer_phone",
            data.get(
                "customerPhone",
                ""
            )
        )
    )

    try:
        customer_note = clean_text(
            data.get("customer_note", ""),
            max_length=MAX_CUSTOMER_NOTE_LENGTH,
            field_name="Customer note"
        )
    except ValueError:

        return jsonify({
            "success": False,
            "message": "Customer note is too long."
        }), 400

    fulfillment_type = str(
        data.get(
            "fulfillment_type",
            data.get(
                "fulfillmentType",
                "Delivery"
            )
        )
    ).strip().title()
    # ========================================================
    # PAYMENT METHOD
    # ========================================================

    payment_method = str(
        data.get(
            "payment_method",
            "Cash"
        )
    ).strip()

    if payment_method not in (
        "Cash",
        "Yoco"
    ):
        return jsonify({
            "success": False,
            "message": "Invalid payment method."
        }), 400

    # Yoco can only be selected when this business
    # has enabled Yoco payments.
    if (
        payment_method == "Yoco"
        and not business.yoco_enabled
    ):
        return jsonify({        "success": False,
        "message": (
            "Yoco payments are not available "
            "for this business."
        )
    }), 400

    customer_address = str(
        data.get(
            "customer_address",
            data.get(
                "delivery_address",
                data.get(
                    "customerAddress",
                    ""
                )
            )
        )
    ).strip()

    items = data.get(
        "items",
        []
    )

    if fulfillment_type not in (
        "Delivery",
        "Pickup"
    ):

        return jsonify({
            "success": False,
            "message": "Please select Delivery or Pickup."
        }), 400

    if fulfillment_type == "Pickup":

        customer_address = ""

    if (
        len(customer_phone) < 10
        or len(customer_phone) > 20
    ):

        return jsonify({
            "success": False,
            "message": "Please enter a valid phone number."
        }), 400

    if (
        fulfillment_type == "Delivery"
        and not customer_address
    ):

        return jsonify({
            "success": False,
            "message": "Delivery address is required."
        }), 400

    if len(customer_address) > MAX_ADDRESS_LENGTH:
        return jsonify({
            "success": False,
            "message": "Delivery address is too long."
        }), 400

    if (
        not isinstance(items, list)
        or not items
    ):

        return jsonify({
            "success": False,
            "message": "Your cart is empty."
        }), 400

    if len(items) > 50:

        return jsonify({
            "success": False,
            "message": "Too many different items in one order."
        }), 400

    clean_items = []

    calculated_total = 0.0

    for item in items:

        if not isinstance(item, dict):
            return jsonify({
                "success": False,
                "message": "Invalid cart item."
            }), 400

        # The browser may send price/name/total fields, but they are
        # deliberately ignored for money calculation. The database
        # Food record is authoritative.
        allowed_item_fields = {"id", "food_id", "name", "quantity"}
        if set(item) - allowed_item_fields:
            return jsonify({
                "success": False,
                "message": "Invalid cart item data."
            }), 400

        raw_food_id = item.get(
            "id",
            item.get(
                "food_id"
            )
        )

        try:

            food_id = int(
                raw_food_id
            )

        except (
            TypeError,
            ValueError
        ):

            food_id = None

        food = None

        if food_id:

            food = Food.query.filter_by(
                id=food_id,
                business_id=business.id,
                available=True
            ).first()

        if not food:

            food_name = str(
                item.get(
                    "name",
                    ""
                )
            ).strip()

            if food_name:

                food = Food.query.filter_by(
                    name=food_name,
                    business_id=business.id,
                    available=True
                ).first()

        if not food:

            return jsonify({
                "success": False,
                "message": (
                    "One of the selected items "
                    "is no longer available."
                )
            }), 400

        try:
            quantity = parse_positive_int(
                item.get("quantity", 0),
                minimum=1,
                maximum=MAX_ITEM_QUANTITY
            )
        except (TypeError, ValueError):
            return jsonify({
                "success": False,
                "message": "Each item quantity must be between 1 and 50."
            }), 400

        if any(existing.get("id") == food.id for existing in clean_items):
            return jsonify({
                "success": False,
                "message": "The same menu item cannot be added more than once."
            }), 400

        item_total = (
            float(food.price)
            * quantity
        )

        calculated_total += (
            item_total
        )

        clean_items.append({
            "id": food.id,
            "name": food.name,
            "price": round(
                float(food.price),
                2
            ),
            "quantity": quantity,
            "total": round(
                item_total,
                2
            )
        })

    if len(clean_items) > MAX_CART_ITEMS:
        return jsonify({
            "success": False,
            "message": "Too many different items in one order."
        }), 400

    if not clean_items:

        return jsonify({
            "success": False,
            "message": "No valid items were selected."
        }), 400

    calculated_total = round(
        calculated_total,
        2
    )

    if calculated_total > MAX_ORDER_TOTAL:
        return jsonify({
            "success": False,
            "message": "This order exceeds the maximum allowed total."
        }), 400

    # ========================================================
        # PROMOTION CODE
    # ========================================================

    promotion_code = str(
        data.get(
            "promotion_code",
            ""
        )
    ).strip().upper()

    promotion_discount = 0.0
    applied_promotion = None

    if len(promotion_code) > MAX_PROMOTION_CODE_LENGTH:
        return jsonify({
            "success": False,
            "message": "Promotion code is too long."
        }), 400

    if promotion_code:

        try:
            # Import the promotion model and calculation
            # helper without creating a circular import.
            from customer_growth import (
                Promotion,
                best_promotion_for_cart,
            )

            promotion = (
                Promotion.query
                .filter_by(
                    business_id=business.id,
                    code=promotion_code,
                    active=True,
                )
                .first()
            )

            if not promotion:

                return jsonify({
                    "success": False,
                    "message": (
                        f"Promotion code "
                        f"'{promotion_code}' is not valid."
                    )
                }), 400

            # The promotion engine performs the actual
            # date, minimum-order, item and discount checks.
            (
                applied_promotion,
                promotion_discount,
                promotion_message,
            ) = best_promotion_for_cart(
                business=business,
                cart_items=clean_items,
                subtotal=calculated_total,
                code=promotion_code,
            )

            if not applied_promotion:

                return jsonify({
                    "success": False,
                    "message": (
                        promotion_message
                        or
                        "This promotion code is not "
                        "currently valid for your order."
                    )
                }), 400

            promotion_discount = round(
                float(promotion_discount or 0),
                2
            )

        except Exception as e:

            safe_log(
                "PROMOTION VALIDATION ERROR:",
                repr(e)
            )

            return jsonify({
                "success": False,
                "message": (
                    "We could not validate the "
                    "promotion code. Please try again."
                )
            }), 400


    # Never allow the discount to exceed the subtotal.
    promotion_discount = max(
        0.0,
        min(
            promotion_discount,
            calculated_total
        )
    )

    final_total = round(
        calculated_total - promotion_discount,
        2
    )

    # ============================================================
    # CREATE ORDER
    # ============================================================

    record_order_attempt()

    daily_order_number, order_day = generate_daily_order_number(
        business.id
    )

    order = Order(
        order_number=daily_order_number,
        order_day=order_day,
        customer_name=customer_name,
        customer_phone=customer_phone,
        customer_address=customer_address,
        items=json.dumps(clean_items),
        total=final_total,
        status="Pending",
        customer_note=(
            customer_note
            if customer_note
            else None
        ),
        business_id=business.id,
        fulfillment_type=fulfillment_type,
        payment_method=payment_method,
        client_request_id=client_request_id
    )

    order_saved = False
    for save_attempt in range(3):
        try:
            db.session.add(order)
            db.session.commit()
            order_saved = True
            break
        except IntegrityError as exc:
            db.session.rollback()

            # A concurrent request may have claimed the same idempotency key.
            if client_request_id:
                existing_order = existing_idempotent_order(
                    business.id,
                    client_request_id
                )
                if existing_order:
                    return jsonify({
                        "success": True,
                        "duplicate": True,
                        "order_id": existing_order.id,
                        "order_number": existing_order.order_number,
                        "total": round(float(existing_order.total), 2),
                        "status": existing_order.status,
                        "payment_method": existing_order.payment_method,
                        "payment_status": existing_order.payment_status,
                        "payment_url": None
                    }), 200

            # A concurrent checkout may have selected the same customer-facing
            # order number. Regenerate it from the now-current database state.
            if save_attempt < 2:
                daily_order_number, order_day = generate_daily_order_number(business.id)
                order.order_number = daily_order_number
                order.order_day = order_day
                continue

            safe_log("ORDER SAVE INTEGRITY ERROR:", repr(exc))
            return jsonify({
                "success": False,
                "message": "Could not save your order. Please try again."
            }), 409
        except Exception as e:
            db.session.rollback()
            safe_log("ORDER SAVE ERROR:", repr(e))
            return jsonify({
                "success": False,
                "message": "Could not save your order."
            }), 500

    if not order_saved:
        return jsonify({
            "success": False,
            "message": "Could not save your order. Please try again."
        }), 409

    grant_order_session_access(order.id)
    # ========================================================
    # YOCO CREATE ONLINE CHECKOUT
    # ========================================================

    yoco_payment_url = None

    if payment_method == "Yoco":

        try:
            yoco_checkout = create_yoco_checkout(
                order,
                business
            )

            yoco_payment_url = (
                yoco_checkout["redirect_url"]
            )

            # Store the Yoco checkout ID so we can
            # verify this exact payment later.
            order.payment_reference = (
                yoco_checkout["checkout_id"]
            )

            order.payment_status = (
                "Awaiting Payment"
            )

            db.session.commit()

            safe_log(
                "YOCO CHECKOUT CREATED:",
                yoco_checkout["checkout_id"]
            )

        except Exception as e:

            db.session.rollback()

            safe_log(
                "YOCO CHECKOUT CREATION ERROR:",
                repr(e)
            )

            return jsonify({
                "success": False,
                "message": (
                    "We could not create the "
                    "Yoco payment. Please try again."
                )
            }), 502

    # ========================================================
    # WHATSAPP  NEW ORDER NOTIFICATION TO BUSINESS
    # ========================================================
    #
    # Yoco orders are notified ONLY after payment is verified.
    # Cash and EFT orders are notified immediately.
    # ========================================================

    if payment_method != "Yoco":

        try:

            notify_business_new_order(
                order,
                business
            )

        except Exception as e:

            safe_log(
                "WHATSAPP NEW ORDER NOTIFICATION ERROR:",
                repr(e)
            )

    # ========================================================
    # FINAL ORDER RESPONSE
    # ========================================================

    return jsonify({
        "success": True,
        "order_id": order.id,
        "order_number": order.order_number,
        "total": final_total,
        "subtotal": calculated_total,
        "discount": promotion_discount,
        "promotion_code": promotion_code,
        "business": business.business_name,
        "status": order.status,
        "fulfillment_type": order.fulfillment_type,
        "payment_method": order.payment_method,
        "payment_status": order.payment_status,
        "payment_url": yoco_payment_url
    }), 200
