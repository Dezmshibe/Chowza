def enforce_database_integrity():
    """Apply safe, additive database hardening to existing installations."""
    from sqlalchemy import text

    backend = db.engine.url.get_backend_name()
    indexes = [
        ("ix_user_business_id", "\"user\"", "\"business_id\""),
        ("ix_food_business_id", "\"food\"", "\"business_id\""),
        ("ix_order_business_id", "\"order\"", "\"business_id\""),
        ("ix_order_business_status", "\"order\"", "\"business_id\", \"status\""),
        ("ix_order_business_created", "\"order\"", "\"business_id\", \"created_at\""),
        ("ix_order_business_order_number", "\"order\"", "\"business_id\", \"order_number\""),
        ("ix_business_active_open", "\"business\"", "\"active\", \"is_open\""),
        ("ix_analytics_business_created", "\"analytics_event\"", "\"business_id\", \"created_at\""),
        ("ix_whatsapp_session_updated", "\"whatsapp_session\"", "\"updated_at\""),
    ]

    for index_name, table_name, columns in indexes:
        try:
            with db.engine.begin() as connection:
                connection.execute(text(
                    f"CREATE INDEX IF NOT EXISTS \"{index_name}\" ON {table_name} ({columns})"
                ))
        except Exception as exc:
            safe_log("DATABASE INDEX HARDENING ERROR:", index_name, repr(exc), level="warning")

    if backend == "sqlite":
        try:
            raw = db.engine.raw_connection()
            try:
                raw.execute("PRAGMA foreign_keys = ON")
                raw.execute("PRAGMA busy_timeout = 10000")
                raw.execute("PRAGMA journal_mode = WAL")
                raw.commit()
            finally:
                raw.close()
        except Exception as exc:
            safe_log("SQLITE HARDENING ERROR:", repr(exc), level="warning")


def setup_database():

    with app.app_context():

        db.create_all()

        # Idempotency column/index prevents duplicate checkout submissions.
        if db.engine.url.get_backend_name() == "sqlite":
            connection = sqlite3.connect(DATABASE_PATH)
            cursor = connection.cursor()
            try:
                cursor.execute('PRAGMA table_info("order")')
                order_columns = {row[1] for row in cursor.fetchall()}
                if "client_request_id" not in order_columns:
                    cursor.execute(
                        'ALTER TABLE "order" ADD COLUMN client_request_id VARCHAR(80)'
                    )
                cursor.execute(
                    'CREATE UNIQUE INDEX IF NOT EXISTS uq_order_business_client_request '
                    'ON "order" (business_id, client_request_id)'
                )
                connection.commit()
            finally:
                connection.close()
        else:
            with db.engine.begin() as connection:
                connection.execute(text(
                    'CREATE UNIQUE INDEX IF NOT EXISTS uq_order_business_client_request '
                    'ON "order" (business_id, client_request_id)'
                ))

        # Customer-facing order numbers must also be unique per business/day.
        # Only create the constraint when existing data is clean; this avoids
        # breaking an older installation that already contains duplicates.
        try:
            duplicate_number = db.session.execute(text(
                'SELECT 1 FROM "order" '
                'WHERE order_number IS NOT NULL AND order_day IS NOT NULL '
                'GROUP BY business_id, order_day, order_number '
                'HAVING COUNT(*) > 1 LIMIT 1'
            )).first()
            if not duplicate_number:
                # Release the read transaction before running DDL on a separate
                # connection, otherwise PostgreSQL can wait on its own session.
                db.session.rollback()
                with db.engine.begin() as connection:
                    connection.execute(text(
                        'CREATE UNIQUE INDEX IF NOT EXISTS uq_order_business_day_number '
                        'ON "order" (business_id, order_day, order_number)'
                    ))
            else:
                safe_log(
                    'DATABASE CONCURRENCY WARNING: duplicate customer order numbers exist; '
                    'unique order-number index was not created.',
                    level='warning'
                )
        except Exception as exc:
            db.session.rollback()
